cmd_gitops_validate() {
  operation_summary "GitOps validation"

  local fail=0

  if ! command -v flux >/dev/null 2>&1; then
    warn "flux CLI missing"
    fail=1
  else
    ok "flux CLI present: $(flux --version 2>/dev/null || true)"
  fi

  if ! kubectl_ctx get nodes >/dev/null 2>&1; then
    warn "Kubernetes target not reachable"
    fail=1
  else
    ok "Kubernetes target reachable"
  fi

  case "$GIT_PROVIDER" in
    github)
      [[ -n "$GITHUB_OWNER" ]] || { warn "github_owner missing"; fail=1; }
      [[ -n "$GITHUB_REPO" ]] || { warn "github_repo missing"; fail=1; }
      [[ -n "$GITHUB_BRANCH" ]] || { warn "github_branch missing"; fail=1; }
      [[ -n "$GITHUB_PATH" ]] || { warn "github_path missing"; fail=1; }
      [[ -n "$GITHUB_TOKEN" ]] || { warn "github_token missing"; fail=1; }
      ;;
    generic)
      [[ -n "$REPO_URL" ]] || { warn "repo_url missing"; fail=1; }
      [[ -n "$REPO_BRANCH" ]] || { warn "repo_branch missing"; fail=1; }
      [[ -n "$REPO_PATH" ]] || { warn "repo_path missing"; fail=1; }
      [[ -n "$REPO_NAME" ]] || { warn "repo_name missing"; fail=1; }
      [[ -n "$KUSTOMIZATION_NAME" ]] || { warn "kustomization_name missing"; fail=1; }
      ;;
    *)
      warn "Unsupported provider: $GIT_PROVIDER"
      fail=1
      ;;
  esac

  if (( fail == 0 )); then
    ok "GitOps prerequisites look ready"
  else
    warn "GitOps prerequisites incomplete"
    return 1
  fi
}

cmd_gitops_deploy() {
  require_management

  cmd_gitops_validate || die "GitOps validation failed"

  case "$GIT_PROVIDER" in
    github)
      cmd_flux_bootstrap_github
      ;;
    generic)
      cmd_flux_sync_generic
      ;;
    *)
      die "Unsupported GitOps provider: $GIT_PROVIDER"
      ;;
  esac
}

