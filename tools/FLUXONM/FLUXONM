management_session_is_active() {
  [[ "${MODE:-SUPERVISION}" == "MANAGEMENT" ]] || return 1

  # CLI management mode is explicit and sufficient for non-destructive config commands.
  # Dashboard management mode should not repeatedly ask to type MANAGEMENT.
  return 0
}

confirm_management() {
  # No repeated typed prompt once user has explicitly selected --mode management
  # or entered Management Mode in dashboard.
  if management_session_is_active; then
    return 0
  fi

  echo
  warn "MANAGEMENT action requested"
  info "Context   : ${LOCKED_CONTEXT}"
  info "Namespace : ${LOCKED_NAMESPACE}"
  read -r -p "Type MANAGEMENT to continue: " typed || true
  [[ "$typed" == "MANAGEMENT" ]]
}

require_management() {
  validate_lock
  if declare -F operation_summary >/dev/null 2>&1; then
    operation_summary "${FUNCNAME[1]:-management-operation}"
  fi
  [[ "$MODE" == "MANAGEMENT" ]] || die "Blocked. Use: $SCRIPT_NAME --mode management <command>"
  confirm_management || die "Management confirmation failed"
}

