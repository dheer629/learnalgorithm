  require_management

  local key="${1:-}"
  local value="${2:-}"

  [[ -n "$key" && -n "$value" ]] || die "Usage: $SCRIPT_NAME --mode management set KEY VALUE"

  case "$key" in
    kubeconfig) KUBECONFIG_PATH="$value" ;;
    context) KUBE_CONTEXT="$value" ;;
    namespace) ACTIVE_NAMESPACE="$value"; LOCKED_NAMESPACE="$value" ;;
    flux_namespace) FLUX_NAMESPACE="$value" ;;
    provider) GIT_PROVIDER="$value" ;;

    vcluster_name) VCLUSTER_NAME="$value"; VCLUSTER_KUBECONFIG="$HOME/.kube/${value}.kubeconfig" ;;
    vcluster_version) VCLUSTER_K8S_VERSION="$value" ;;
    vcluster_distro) VCLUSTER_DISTRO="$value" ;;

    flux_cli_version) FLUX_CLI_VERSION="$value" ;;

    # Legacy GitHub keys
    github_owner) GITHUB_OWNER="$value"; GIT_OWNER="$value" ;;
    github_repo) GITHUB_REPO="$value"; GIT_REPOSITORY="$value" ;;
    github_branch) GITHUB_BRANCH="$value"; GIT_BRANCH="$value" ;;
    github_path) GITHUB_PATH="$value"; GIT_PATH="$value" ;;
    github_token) GITHUB_TOKEN="$value"; GIT_TOKEN="$value" ;;

    # Legacy generic keys
    repo_url) REPO_URL="$value"; GIT_URL="$value"; GITOPS_COMMIT_REPO_URL="$value" ;;
    repo_branch) REPO_BRANCH="$value"; GIT_BRANCH="$value"; GITOPS_COMMIT_BRANCH="$value" ;;
    repo_path) REPO_PATH="$value"; GIT_PATH="$value"; GITOPS_COMMIT_PATH="$value" ;;
    repo_name) REPO_NAME="$value" ;;
    kustomization_name) KUSTOMIZATION_NAME="$value" ;;
    interval) SYNC_INTERVAL="$value" ;;
    retry_interval) RETRY_INTERVAL="$value" ;;
    timeout) TIMEOUT="$value" ;;

    # Universal GitOps keys
    git_provider) GIT_PROVIDER="$value" ;;
    git_hostname) GIT_HOSTNAME="$value" ;;
    git_owner) GIT_OWNER="$value"; GITHUB_OWNER="$value" ;;
    git_repository|git_repo) GIT_REPOSITORY="$value"; GITHUB_REPO="$value" ;;
    git_branch) GIT_BRANCH="$value"; REPO_BRANCH="$value"; GITHUB_BRANCH="$value"; GITOPS_COMMIT_BRANCH="$value" ;;
    git_path) GIT_PATH="$value"; REPO_PATH="$value"; GITHUB_PATH="$value"; GITOPS_COMMIT_PATH="$value" ;;
    git_username) GIT_USERNAME="$value" ;;
    git_token) GIT_TOKEN="$value"; GITHUB_TOKEN="$value" ;;
    git_url) GIT_URL="$value"; REPO_URL="$value"; GITOPS_COMMIT_REPO_URL="$value" ;;
    git_auth_mode) GIT_AUTH_MODE="$value" ;;
    git_private_key_file) GIT_PRIVATE_KEY_FILE="$value" ;;
    git_password) GIT_PASSWORD="$value" ;;
    git_personal) GIT_PERSONAL="$value" ;;
    git_private) GIT_PRIVATE="$value" ;;
    git_with_bearer_token) GIT_WITH_BEARER_TOKEN="$value" ;;
    git_extra_flags) GIT_EXTRA_FLAGS="$value" ;;

    # Public repo workflow keys
    gitops_repo_url) GITOPS_COMMIT_REPO_URL="$value"; GIT_URL="$value"; REPO_URL="$value" ;;
    gitops_branch) GITOPS_COMMIT_BRANCH="$value"; GIT_BRANCH="$value"; REPO_BRANCH="$value" ;;
    gitops_path) GITOPS_COMMIT_PATH="$value"; GIT_PATH="$value"; REPO_PATH="$value" ;;
