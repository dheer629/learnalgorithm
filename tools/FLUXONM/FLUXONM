# ------------------------------------------------------------------------------
# Self-test / static validation
# ------------------------------------------------------------------------------

cmd_self_test() {
  DHEER_SKIP_READ_CONFIRM=1
  header
  step "Self-test"

  local fail=0

  echo "Script      : $0"
  echo "Version     : $SCRIPT_VERSION"
  echo "State dir   : $STATE_DIR"
  echo "Output dir  : $OUTDIR"
  echo

  echo "1) Bash syntax"
  if bash -n "$0"; then
    ok "bash -n passed"
  else
    err "bash -n failed"
    fail=1
  fi

  echo
  echo "2) Required local commands"
  for c in awk sed grep sort find date mkdir chmod cp mv rm cat tr printf; do
    if command -v "$c" >/dev/null 2>&1; then
      ok "$c present"
    else
      err "$c missing"
      fail=1
    fi
  done

  echo
  echo "3) Optional Kubernetes tools"
  for c in kubectl helm vcluster flux jq curl git less; do
    if command -v "$c" >/dev/null 2>&1; then
      ok "$c present"
    else
      warn "$c missing; setup can install or validate it"
    fi
  done

  echo
  echo "4) Preference and lock visibility"
  if [[ -r "$PREF_FILE" ]]; then
    ok "preferences readable: $PREF_FILE"
  else
    warn "preferences not found yet: $PREF_FILE"
  fi

  echo
  echo "5) Function alignment"
  local needed=(
    cmd_start cmd_dashboard cmd_setup cmd_detect cmd_context_select cmd_namespace_select
    cmd_lock_init cmd_lock_show cmd_doctor cmd_status cmd_k8s_status cmd_k8s_pods
    cmd_k8s_events cmd_k8s_logs cmd_k8s_describe cmd_k8s_yaml cmd_vcluster_status
    cmd_vcluster_create cmd_vcluster_delete cmd_flux_install cmd_flux_status
    cmd_flux_health cmd_flux_logs cmd_flux_trace cmd_flux_sync_generic cmd_diagnostics
  )

  local fn
  for fn in "${needed[@]}"; do
    if declare -F "$fn" >/dev/null 2>&1; then
      ok "$fn available"
    else
      err "$fn missing"
      fail=1
    fi
  done

  echo
  echo "6) Current target validation"
  if [[ -s "$KUBECONFIG_PATH" ]] && command -v kubectl >/dev/null 2>&1; then
    if kubectl_ctx get nodes >/dev/null 2>&1; then
      ok "Kubernetes target reachable"
      kubectl_ctx get nodes -o wide || true
    else
      warn "Kubernetes target not reachable with current preferences"
    fi
  else
    warn "Kubernetes target not validated; kubeconfig or kubectl missing"
  fi

  echo
  if (( fail == 0 )); then
    ok "Self-test completed successfully"
  else
    die "Self-test found issues"
  fi
}


