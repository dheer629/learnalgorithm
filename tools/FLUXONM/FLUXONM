mkdir -p "$PF_DIR" 2>/dev/null || true

# ------------------------------------------------------------------------------
# Defaults
# ------------------------------------------------------------------------------

MODE="${MODE:-SUPERVISION}"                         # SUPERVISION | MANAGEMENT
KUBECONFIG_PATH="${KUBECONFIG_PATH:-${KUBECONFIG:-$HOME/.kube/dev.kubeconfig}}"
KUBE_CONTEXT="${KUBE_CONTEXT:-}"
