count_k8s() {
  local resource="$1"
  kubectl_ctx get "$resource" -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | wc -l | tr -d ' '
}

count_flux() {
  local resource="$1"
  kubectl_ctx get "$resource" -n "$FLUX_NAMESPACE" --no-headers 2>/dev/null | wc -l | tr -d ' '
}

safe_short() {
  local value="${1:-}"
  local max="${2:-48}"
  if (( ${#value} > max )); then
    printf '%s…' "${value:0:max}"
  else
    printf '%s' "$value"
  fi
}

gitops_provider_summary() {
  case "${GIT_PROVIDER:-generic}" in
    github)
      printf 'GitHub │ %s/%s │ branch=%s │ path=%s' \
        "${GITHUB_OWNER:-unset}" "${GITHUB_REPO:-unset}" "${GITHUB_BRANCH:-main}" "${GITHUB_PATH:-clusters/dev}"
      ;;
    generic)
      printf 'Generic │ %s │ branch=%s │ path=%s' \
        "$(safe_short "${REPO_URL:-unset}" 52)" "${REPO_BRANCH:-main}" "${REPO_PATH:-clusters/dev}"
      ;;
    *)
      printf '%s │ not configured' "${GIT_PROVIDER:-unset}"
      ;;
  esac
}

dashboard_snapshot() {
  load_prefs >/dev/null 2>&1 || true

  local nodes="?"
  local pods="?"
  local deploys="?"
  local svc="?"
  local flux_pods="?"
  local gitrepos="?"
  local kustomizations="?"
  local vclusters="?"

  if command -v kubectl >/dev/null 2>&1 && [[ -s "${KUBECONFIG_PATH:-}" ]]; then
    nodes="$(kubectl_ctx get nodes --no-headers 2>/dev/null | wc -l | tr -d ' ' || echo '?')"
    pods="$(count_k8s pods || echo '?')"
    deploys="$(count_k8s deploy || echo '?')"
    svc="$(count_k8s svc || echo '?')"

    if kubectl_ctx get ns "$FLUX_NAMESPACE" >/dev/null 2>&1; then
      flux_pods="$(count_flux pods || echo '?')"
      gitrepos="$(kubectl_ctx get gitrepositories -A --no-headers 2>/dev/null | wc -l | tr -d ' ' || echo '?')"
      kustomizations="$(kubectl_ctx get kustomizations -A --no-headers 2>/dev/null | wc -l | tr -d ' ' || echo '?')"
    else
      flux_pods="0"
      gitrepos="0"
      kustomizations="0"
    fi
  fi

  if command -v vcluster >/dev/null 2>&1; then
    vclusters="$(vcluster list 2>/dev/null | awk 'NR>1 && NF {c++} END{print c+0}' || echo '?')"
  fi

  local w
  w="$(term_width)"
  box_top "$w"
  box_line " CLUSTER nodes=${nodes} │ NS pods=${pods} deploy=${deploys} svc=${svc} │ vCluster=${vclusters}" "$w"
  box_line " FLUX ns=${FLUX_NAMESPACE} pods=${flux_pods} gitrepos=${gitrepos} kustomizations=${kustomizations}" "$w"
  box_line " GITOPS $(gitops_provider_summary)" "$w"
  box_bottom "$w"
}

