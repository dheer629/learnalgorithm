need_git_write_credentials() {
  # Bootstrap + commit/push require write access for HTTPS repos.
  case "${GIT_AUTH_MODE:-token}" in
    token|basic|bearer)
      [[ -n "${GIT_TOKEN:-}" || -n "${GITHUB_TOKEN:-}" ]]
      ;;
    ssh)
      [[ -n "${GIT_PRIVATE_KEY_FILE:-}" ]]
      ;;
    none)
      return 1
      ;;
    *)
      return 1
      ;;
  esac
}

validate_public_repo_inputs() {
  normalize_gitops_inputs
  local fail=0

  [[ -n "${PUBLIC_APP_NAME:-}" ]] || { warn "Application name missing"; fail=1; }
  [[ -n "${PUBLIC_APP_NAMESPACE:-}" ]] || { warn "Application namespace missing"; fail=1; }
  [[ -n "${PUBLIC_APP_REPO_URL:-}" ]] || { warn "Public repo URL missing"; fail=1; }
  [[ -n "${PUBLIC_APP_REPO_BRANCH:-}" ]] || { warn "Public repo branch missing"; fail=1; }
  [[ -n "${PUBLIC_APP_REPO_PATH:-}" ]] || { warn "Public repo path missing"; fail=1; }
  [[ -n "${GITOPS_COMMIT_REPO_URL:-}" ]] || { warn "Your GitOps repo clone URL missing"; fail=1; }
  [[ -n "${GITOPS_COMMIT_BRANCH:-}" ]] || { warn "Your GitOps repo branch missing"; fail=1; }
  [[ -n "${GITOPS_COMMIT_PATH:-}" ]] || { warn "GitOps source-of-truth path missing"; fail=1; }

  if looks_like_git_url "${GITOPS_COMMIT_BRANCH:-}"; then
    warn "GitOps branch contains a Git URL: $GITOPS_COMMIT_BRANCH"
    warn "Fix: branch should be main/master/develop; URL belongs in GitOps repo clone URL."
    fail=1
  fi

  if ! looks_like_branch_name "${GITOPS_COMMIT_BRANCH:-}"; then
    warn "GitOps branch is invalid: ${GITOPS_COMMIT_BRANCH:-unset}"
    fail=1
  fi

  if ! looks_like_git_url "${GITOPS_COMMIT_REPO_URL:-}"; then
    warn "GitOps repo clone URL does not look like a Git URL: ${GITOPS_COMMIT_REPO_URL:-unset}"
    fail=1
  fi

  if [[ "${GITOPS_COMMIT_REPO_URL:-}" =~ ^https://github.com/ ]] && ! need_git_write_credentials; then
    warn "GitHub HTTPS GitOps repo requires write credentials for bootstrap/commit/push."
    warn "Set a GitHub token with repo write access:"
    warn "  FLUXONM --mode management set git_token '<github-token>'"
    warn "or use the GitOps wizard to enter token/PAT."
    fail=1
  fi

  (( fail == 0 ))
}

cmd_gitops_validate() {
  operation_summary "GitOps validation"
  if [[ -n "${GITOPS_COMMIT_REPO_URL:-}" || -n "${GITOPS_COMMIT_BRANCH:-}" || -n "${GITOPS_COMMIT_PATH:-}" ]]; then
    sync_gitops_bootstrap_vars
  else
    normalize_gitops_inputs
  fi

  local fail=0

  command -v flux >/dev/null 2>&1 && ok "flux CLI present: $(flux --version 2>/dev/null || true)" || { warn "flux CLI missing"; fail=1; }
  kubectl_ctx get nodes >/dev/null 2>&1 && ok "Kubernetes target reachable" || { warn "Kubernetes target not reachable"; fail=1; }

  case "$GIT_PROVIDER" in
    github|gitlab|gitea)
      [[ -n "$GIT_OWNER" ]] || { warn "git owner/group missing"; fail=1; }
      [[ -n "$GIT_REPOSITORY" ]] || { warn "git repository missing"; fail=1; }
      [[ -n "$GIT_BRANCH" ]] || { warn "git branch missing"; fail=1; }
      [[ -n "$GIT_PATH" ]] || { warn "git path missing"; fail=1; }
      [[ "$GIT_AUTH_MODE" != "token" || -n "$GIT_TOKEN" || -n "$GITHUB_TOKEN" ]] || { warn "token/PAT missing"; fail=1; }
      ;;
    bitbucket-server)
      [[ -n "$GIT_OWNER" ]] || { warn "Bitbucket project/user missing"; fail=1; }
      [[ -n "$GIT_REPOSITORY" ]] || { warn "Bitbucket repository missing"; fail=1; }
      [[ -n "$GIT_HOSTNAME" ]] || { warn "Bitbucket Server hostname missing"; fail=1; }
      [[ -n "$GIT_USERNAME" ]] || { warn "Bitbucket username missing"; fail=1; }
      [[ "$GIT_AUTH_MODE" != "token" || -n "$GIT_TOKEN" ]] || { warn "Bitbucket token missing"; fail=1; }
      ;;
    generic|azure-devops|aws-codecommit|google-cloud-source|bitbucket-cloud)
      [[ -n "$GIT_URL" ]] || { warn "git URL missing"; fail=1; }
      [[ -n "$GIT_BRANCH" ]] || { warn "git branch missing"; fail=1; }
      [[ -n "$GIT_PATH" ]] || { warn "git path missing"; fail=1; }
      if ! looks_like_branch_name "$GIT_BRANCH"; then
        warn "git branch is invalid: $GIT_BRANCH"
        fail=1
      fi
      if [[ "$GIT_AUTH_MODE" == "ssh" && -z "$GIT_PRIVATE_KEY_FILE" ]]; then
        warn "SSH auth selected but private key file is missing"
        fail=1
      fi
      if [[ "$GIT_AUTH_MODE" =~ ^(token|basic|bearer)$ && "$GIT_URL" =~ ^https://github.com/ && -z "$GIT_TOKEN" && -z "$GITHUB_TOKEN" ]]; then
        warn "GitHub HTTPS bootstrap requires token/PAT for write access"
        fail=1
      fi
      ;;
    *)
      warn "Unsupported Git provider: $GIT_PROVIDER"
      fail=1
      ;;
  esac

  if (( fail == 0 )); then
    ok "GitOps prerequisites look ready"
  else
    warn "GitOps prerequisites incomplete"
    return 1
  fi
}


