# ------------------------------------------------------------------------------

cmd_k8s_status() {
  header
  require_supervision
  kubectl_ctx get all -n "$ACTIVE_NAMESPACE" -o wide || true
  echo
  kubectl_ctx get cm,secret,sa,role,rolebinding,pvc,ingress -n "$ACTIVE_NAMESPACE" -o wide || true
}

cmd_k8s_pods() {
  require_supervision
  kubectl_ctx get pods -n "$ACTIVE_NAMESPACE" -o wide || true
}

cmd_k8s_events() {
  require_supervision
  kubectl_ctx get events -n "$ACTIVE_NAMESPACE" --sort-by=.lastTimestamp
}

cmd_k8s_top() {
  require_supervision
  kubectl_ctx top nodes || true
  echo
  kubectl_ctx top pods -n "$ACTIVE_NAMESPACE" || true
}

cmd_k8s_yaml() {
  require_supervision
  local out="$OUTDIR/namespace-${ACTIVE_NAMESPACE}.yaml"
  kubectl_ctx get all,cm,secret,sa,role,rolebinding,pvc,ingress -n "$ACTIVE_NAMESPACE" -o yaml > "$out" 2>/dev/null || true
  ok "YAML exported: $out"
}

cmd_k8s_logs() {
  require_supervision
  local pods=()
  local pod file rc

  while true; do
    resource_summary "Namespace Resource Summary before Logs"
    echo
    echo "Pods in namespace: $ACTIVE_NAMESPACE"
    kubectl_ctx get pods -n "$ACTIVE_NAMESPACE" -o wide 2>/dev/null || true

    mapfile -t pods < <(kubectl_ctx get pods -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | awk '{print $1}' | sort)

    if [[ ${#pods[@]} -eq 0 ]]; then
      warn "No pods available in namespace: $ACTIVE_NAMESPACE"
      echo
      echo "Suggestions:"
      echo "  - Press c in dashboard to choose another namespace"
      echo "  - Run: $SCRIPT_NAME k8s-status"
      return 0
    fi

    set +e
    pod="$(select_from_list "Select pod for full searchable logs" "${pods[@]}")"
    rc=$?
    set -e

    [[ $rc -eq 2 ]] && continue
    [[ $rc -eq 0 ]] || { warn "Log selection cancelled."; return 0; }
    break
  done

  file="$OUTDIR/logs-${ACTIVE_NAMESPACE}-${pod}.log"
  show_command_preview "Full pod logs" kubectl logs -n "$ACTIVE_NAMESPACE" "$pod" --all-containers=true
  info "Capturing FULL logs without trimming. Search inside less using /pattern"
  kubectl_ctx logs -n "$ACTIVE_NAMESPACE" "$pod" --all-containers=true > "$file" 2>&1 || true
  ok "Full logs captured: $file"
  viewer "$file"
}

cmd_k8s_describe() {
  require_supervision
  local resource_types=("pod" "deploy" "sts" "ds" "svc" "cm" "secret" "pvc" "job" "cronjob" "ingress")
  local rtype name rc

  resource_summary "Namespace Resource Summary before Describe"
  echo
  kubectl_ctx get all -n "$ACTIVE_NAMESPACE" -o wide 2>/dev/null || true

  set +e
  rtype="$(select_from_list "Select resource type" "${resource_types[@]}")"
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { warn "Describe cancelled."; return 0; }

  set +e
  name="$(select_k8s_resource_name "$rtype" "Select $rtype to describe")"
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { warn "No $rtype selected."; return 0; }

  show_command_preview "Describe resource" kubectl describe "$rtype" "$name" -n "$ACTIVE_NAMESPACE"
  kubectl_ctx describe "$rtype" "$name" -n "$ACTIVE_NAMESPACE"
}

# ------------------------------------------------------------------------------
# Kubernetes management
# ------------------------------------------------------------------------------

cmd_k8s_rollout_restart() {
  require_management
  read -r -p "Resource type [deploy]: " rtype; rtype="${rtype:-deploy}"
  mapfile -t names < <(kubectl_ctx get "$rtype" -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | awk '{print $1}')
  [[ ${#names[@]} -gt 0 ]] || die "No resources found"
  local name
  name="$(select_from_list "Select resource" "${names[@]}")" || die "Invalid selection"
  kubectl_ctx rollout restart "$rtype/$name" -n "$ACTIVE_NAMESPACE"
  audit "rollout-restart" "$rtype/$name"
}

cmd_k8s_scale() {
  require_management
  read -r -p "Resource type [deploy]: " rtype; rtype="${rtype:-deploy}"
  mapfile -t names < <(kubectl_ctx get "$rtype" -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | awk '{print $1}')
  [[ ${#names[@]} -gt 0 ]] || die "No resources found"
  local name replicas
  name="$(select_from_list "Select resource" "${names[@]}")" || die "Invalid selection"
  read -r -p "Replicas: " replicas
  [[ "$replicas" =~ ^[0-9]+$ ]] || die "Invalid replicas"
  kubectl_ctx scale "$rtype/$name" -n "$ACTIVE_NAMESPACE" --replicas="$replicas"
  audit "scale" "$rtype/$name replicas=$replicas"
}

cmd_pod_delete() {
  require_management
  local pod rc
  resource_summary "Before Pod Delete"
  kubectl_ctx get pods -n "$ACTIVE_NAMESPACE" -o wide || true
  set +e
  pod="$(select_k8s_resource_name "pod" "Select pod to delete")"
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { warn "Pod delete cancelled."; return 0; }
  show_command_preview "Delete pod" kubectl delete pod "$pod" -n "$ACTIVE_NAMESPACE"
  kubectl_ctx delete pod "$pod" -n "$ACTIVE_NAMESPACE"
  audit "pod-delete" "$pod"
}

cmd_pod_force_delete() {
  require_management
  local pod rc
  resource_summary "Before FORCE Pod Delete"
  kubectl_ctx get pods -n "$ACTIVE_NAMESPACE" -o wide || true
  set +e
  pod="$(select_k8s_resource_name "pod" "Select pod to FORCE delete")"
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { warn "Force pod delete cancelled."; return 0; }
  show_command_preview "Force delete pod" kubectl delete pod "$pod" -n "$ACTIVE_NAMESPACE" --force --grace-period=0
  read -r -p "Type FORCE to delete $pod immediately: " typed
  [[ "$typed" == "FORCE" ]] || die "Force delete aborted"
  kubectl_ctx delete pod "$pod" -n "$ACTIVE_NAMESPACE" --force --grace-period=0
  audit "pod-force-delete" "$pod"
}

