port_forward_pid_alive() {
  local pid="${1:-}"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1
}

cmd_app_port_forward_status() {
  header
  require_supervision

  section "Port-forward Status"

  if [[ ! -f "$PF_STATE_FILE" ]]; then
    warn "No port-forward state file found."
    echo "Start it with:"
    echo "  FLUXONM --mode management app-forward"
    return 0
  fi

  # shellcheck disable=SC1090
  . "$PF_STATE_FILE"

  echo "State file       : $PF_STATE_FILE"
  echo "PID              : ${PF_PID:-unset}"
  echo "Namespace        : ${PF_NAMESPACE:-unset}"
  echo "Service          : ${PF_SERVICE:-unset}"
  echo "Local port       : ${PF_LOCAL_PORT:-unset}"
  echo "Service port     : ${PF_SERVICE_PORT:-unset}"
  echo "Log file         : ${PF_LOG_FILE:-unset}"
  echo "URL              : http://localhost:${PF_LOCAL_PORT:-9898}"
  echo

  if port_forward_pid_alive "${PF_PID:-}"; then
    ok "Port-forward is running"
  else
    warn "Port-forward is not running"
  fi

  if [[ -f "${PF_LOG_FILE:-}" ]]; then
    echo
    echo "Recent port-forward log:"
    tail -30 "$PF_LOG_FILE" || true
  fi
}

cmd_app_forward() {
  require_management

  local app_ns="${PUBLIC_APP_NAMESPACE:-podinfo-demo}"
  local app_svc="${PUBLIC_APP_SERVICE:-podinfo}"
  local local_port="${PUBLIC_APP_LOCAL_PORT:-9898}"
  local svc_port="${PUBLIC_APP_SERVICE_PORT:-9898}"
  local log_file="$PF_DIR/${app_ns}-${app_svc}-${local_port}.log"

  section "Start Application Port-forward"
  echo "Namespace        : $app_ns"
  echo "Service          : $app_svc"
  echo "Forward          : localhost:${local_port} -> service/${app_svc}:${svc_port}"
  echo "Log              : $log_file"
  echo

  if [[ -f "$PF_STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    . "$PF_STATE_FILE" || true
    if port_forward_pid_alive "${PF_PID:-}"; then
      ok "Port-forward already running: PID ${PF_PID}"
      echo "URL: http://localhost:${PF_LOCAL_PORT:-$local_port}"
      return 0
    fi
  fi

  kubectl_ctx get ns "$app_ns" >/dev/null 2>&1 || die "Namespace not found: $app_ns"
  kubectl_ctx get svc "$app_svc" -n "$app_ns" >/dev/null 2>&1 || die "Service not found: $app_ns/$app_svc"

  mkdir -p "$PF_DIR"
  : > "$log_file"

  nohup kubectl --kubeconfig "$KUBECONFIG_PATH" ${KUBE_CONTEXT:+--context "$KUBE_CONTEXT"} \
    -n "$app_ns" port-forward "svc/$app_svc" "${local_port}:${svc_port}" \
    > "$log_file" 2>&1 &

  local pid=$!
  sleep 2

  cat > "$PF_STATE_FILE" <<EOF
PF_PID="$pid"
PF_NAMESPACE="$app_ns"
PF_SERVICE="$app_svc"
PF_LOCAL_PORT="$local_port"
PF_SERVICE_PORT="$svc_port"
PF_LOG_FILE="$log_file"
PF_STARTED_AT="$(date -Is)"
EOF

  if port_forward_pid_alive "$pid"; then
    ok "Port-forward started: PID $pid"
    echo "URL: http://localhost:${local_port}"
    echo "Log: $log_file"
    echo
    tail -20 "$log_file" || true
  else
    warn "Port-forward process exited. Check log: $log_file"
    cat "$log_file" || true
    return 1
  fi
}

cmd_app_forward_stop() {
  require_management

  section "Stop Application Port-forward"

  if [[ ! -f "$PF_STATE_FILE" ]]; then
    warn "No port-forward state file found."
    return 0
  fi

  # shellcheck disable=SC1090
  . "$PF_STATE_FILE"

  if port_forward_pid_alive "${PF_PID:-}"; then
    kill "$PF_PID" >/dev/null 2>&1 || true
    sleep 1
    if port_forward_pid_alive "$PF_PID"; then
      kill -9 "$PF_PID" >/dev/null 2>&1 || true
    fi
    ok "Stopped port-forward PID: $PF_PID"
  else
    warn "Port-forward PID not running: ${PF_PID:-unset}"
  fi

  rm -f "$PF_STATE_FILE"
}

cmd_app_forward_restart() {
  require_management
  cmd_app_forward_stop || true
  cmd_app_forward
