cmd_flux_logs() {
  require_supervision
  local file="$OUTDIR/flux-controller-full-logs.log"
  : > "$file"
  for ctrl in source-controller kustomize-controller helm-controller notification-controller image-reflector-controller image-automation-controller; do
    echo "===== $ctrl =====" >> "$file"
    if kubectl_ctx -n "$FLUX_NAMESPACE" get deploy "$ctrl" >/dev/null 2>&1; then
      kubectl_ctx logs -n "$FLUX_NAMESPACE" deploy/"$ctrl" --all-containers=true >> "$file" 2>&1 || true
    else
      echo "Deployment not installed: $ctrl" >> "$file"
    fi
    echo >> "$file"
  done
  ok "Full Flux logs captured: $file"
  viewer "$file"
}

cmd_flux_trace() {
  require_supervision
  if ! flux_crds_exist; then warn "Flux CRDs missing"; return 0; fi
  kubectl_ctx get kustomizations -A --no-headers 2>/dev/null | while read -r ns name rest; do
    echo "===== Kustomization $ns/$name ====="
    flux_ctx trace kustomization "$name" -n "$ns" || true
  done
  kubectl_ctx get gitrepositories -A --no-headers 2>/dev/null | while read -r ns name rest; do
    echo "===== GitRepository $ns/$name ====="
    flux_ctx trace source git "$name" -n "$ns" || true
  done
}

cmd_flux_bootstrap_github() {
  require_management
  [[ -n "$GITHUB_OWNER" && -n "$GITHUB_REPO" && -n "$GITHUB_TOKEN" ]] || die "Set github_owner/github_repo/github_token first"
  export GITHUB_TOKEN
  flux_ctx bootstrap github --owner="$GITHUB_OWNER" --repository="$GITHUB_REPO" --branch="$GITHUB_BRANCH" --path="$GITHUB_PATH" --personal --token-auth --namespace="$FLUX_NAMESPACE"
  audit "flux-bootstrap-github" "$GITHUB_OWNER/$GITHUB_REPO $GITHUB_PATH"
}

cmd_flux_sync_generic() {
  require_management
  [[ -n "$REPO_URL" ]] || die "Set repo_url first"
  if ! flux_ns_exists; then cmd_flux_install; fi

  cat <<YAML | kubectl_ctx apply -f -
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: ${REPO_NAME}
  namespace: ${FLUX_NAMESPACE}
spec:
  interval: ${SYNC_INTERVAL}
  url: ${REPO_URL}
  ref:
    branch: ${REPO_BRANCH}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: ${KUSTOMIZATION_NAME}
  namespace: ${FLUX_NAMESPACE}
spec:
  interval: ${SYNC_INTERVAL}
  retryInterval: ${RETRY_INTERVAL}
  timeout: ${TIMEOUT}
  sourceRef:
    kind: GitRepository
    name: ${REPO_NAME}
  path: ./${REPO_PATH}
  prune: true
  wait: true
YAML
  audit "flux-sync-generic" "$REPO_URL $REPO_PATH"
  cmd_flux_reconcile
}

cmd_flux_reconcile() {
  require_management
  flux_ctx reconcile source git "$REPO_NAME" -n "$FLUX_NAMESPACE" --with-source || true
  flux_ctx reconcile kustomization "$KUSTOMIZATION_NAME" -n "$FLUX_NAMESPACE" --with-source || true
  audit "flux-reconcile" "$REPO_NAME $KUSTOMIZATION_NAME"
}

cmd_flux_suspend() { require_management; flux_ctx suspend kustomization "$KUSTOMIZATION_NAME" -n "$FLUX_NAMESPACE"; }
cmd_flux_resume() { require_management; flux_ctx resume kustomization "$KUSTOMIZATION_NAME" -n "$FLUX_NAMESPACE"; }

cmd_flux_delete_sync() {
  require_management
  kubectl_ctx delete kustomization "$KUSTOMIZATION_NAME" -n "$FLUX_NAMESPACE" --ignore-not-found
  kubectl_ctx delete gitrepository "$REPO_NAME" -n "$FLUX_NAMESPACE" --ignore-not-found
  audit "flux-delete-sync" "$REPO_NAME $KUSTOMIZATION_NAME"
}


cmd_quick_filter() {
  require_supervision
  local resource_types=("pods" "deploy" "sts" "ds" "svc" "pvc" "cm" "secret" "events" "all")
  local rtype filter rc out

  set +e
  rtype="$(select_from_list "Select quick-filter resource type" "${resource_types[@]}")"
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { warn "Quick filter cancelled."; return 0; }

  read -r -p "Filter text (blank for all): " filter || true
  out="$OUTDIR/quick-filter-${ACTIVE_NAMESPACE}-${rtype}.out"

  case "$rtype" in
    events)
      kubectl_ctx get events -n "$ACTIVE_NAMESPACE" --sort-by=.lastTimestamp > "$out" 2>&1 || true
      ;;
    all)
      kubectl_ctx get all -n "$ACTIVE_NAMESPACE" -o wide > "$out" 2>&1 || true
      ;;
    *)
      kubectl_ctx get "$rtype" -n "$ACTIVE_NAMESPACE" -o wide > "$out" 2>&1 || true
      ;;
  esac

  if [[ -n "$filter" ]]; then
    grep -i -- "$filter" "$out" > "${out}.filtered" || true
    mv "${out}.filtered" "$out"
  fi

  ok "Quick filter output: $out"
  viewer "$out"
}

