touch "$MASTER_LOG" "$COMMAND_INDEX" 2>/dev/null || true

PF_DIR="$STATE_DIR/port-forward"
PF_STATE_FILE="$PF_DIR/podinfo-demo.state"

VCLUSTER_STATE_DIR="${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}"
VCLUSTER_CONTAINER_PREFIX="${VCLUSTER_CONTAINER_PREFIX:-vcluster.cp}"
