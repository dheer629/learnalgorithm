# Public repo deployment guardrails
# ------------------------------------------------------------------------------

looks_like_git_url() {
  local v="${1:-}"
  [[ "$v" =~ ^https?:// || "$v" =~ ^ssh:// || "$v" =~ ^git@ || "$v" == *.git ]]
}

looks_like_branch_name() {
  local v="${1:-}"
  [[ -n "$v" && ! "$v" =~ ^https?:// && ! "$v" =~ ^ssh:// && ! "$v" =~ [[:space:]] && ! "$v" == *.git ]]
}

read_branch_guarded() {
  local prompt="$1"
  local current="${2:-main}"
  local value=""
  while true; do
    value="$(read_value "$prompt" "$current")"
    if looks_like_git_url "$value"; then
      warn "You entered a Git URL where a branch name is expected: $value"
      warn "Branch should be a simple value like: main, master, develop"
      echo
      read -r -p "Use 'main' as branch and treat this as GitOps repo URL? [Y/n]: " fix || true
      fix="${fix:-Y}"
      if [[ "$fix" =~ ^[Yy]$ ]]; then
        GITOPS_COMMIT_REPO_URL="$value"
        value="main"
        break
      fi
      continue
    fi
    if looks_like_branch_name "$value"; then
      break
    fi
    warn "Invalid branch value: $value"
  done
  printf '%s' "$value"
}

sync_gitops_bootstrap_vars() {
  # Public repo workflow owns the source-of-truth repo URL/branch/path.
  # Keep all generic Flux bootstrap variables aligned before validation/deploy.
  if [[ -n "${GITOPS_COMMIT_REPO_URL:-}" ]]; then
    GIT_URL="$GITOPS_COMMIT_REPO_URL"
    REPO_URL="$GITOPS_COMMIT_REPO_URL"
  fi

  if [[ -n "${GITOPS_COMMIT_BRANCH:-}" ]]; then
    GIT_BRANCH="$GITOPS_COMMIT_BRANCH"
    REPO_BRANCH="$GITOPS_COMMIT_BRANCH"
    GITHUB_BRANCH="$GITOPS_COMMIT_BRANCH"
  fi

  if [[ -n "${GITOPS_COMMIT_PATH:-}" ]]; then
    GIT_PATH="$GITOPS_COMMIT_PATH"
    REPO_PATH="$GITOPS_COMMIT_PATH"
    GITHUB_PATH="$GITOPS_COMMIT_PATH"
  fi

  # If no provider-specific bootstrap is configured, generic git is the safest universal path.
  if [[ -z "${GIT_PROVIDER:-}" || "${GIT_PROVIDER:-generic}" == "generic" ]]; then
    GIT_PROVIDER="generic"
    GIT_AUTH_MODE="${GIT_AUTH_MODE:-token}"
  fi
}

validate_public_repo_inputs() {
  local fail=0

  [[ -n "${PUBLIC_APP_NAME:-}" ]] || { warn "Application name missing"; fail=1; }
  [[ -n "${PUBLIC_APP_NAMESPACE:-}" ]] || { warn "Application namespace missing"; fail=1; }
  [[ -n "${PUBLIC_APP_REPO_URL:-}" ]] || { warn "Public repo URL missing"; fail=1; }
  [[ -n "${PUBLIC_APP_REPO_BRANCH:-}" ]] || { warn "Public repo branch missing"; fail=1; }
  [[ -n "${PUBLIC_APP_REPO_PATH:-}" ]] || { warn "Public repo path missing"; fail=1; }
  [[ -n "${GITOPS_COMMIT_REPO_URL:-}" ]] || { warn "Your GitOps repo clone URL missing"; fail=1; }
  [[ -n "${GITOPS_COMMIT_BRANCH:-}" ]] || { warn "Your GitOps repo branch missing"; fail=1; }
  [[ -n "${GITOPS_COMMIT_PATH:-}" ]] || { warn "GitOps source-of-truth path missing"; fail=1; }

  if looks_like_git_url "${GITOPS_COMMIT_BRANCH:-}"; then
    warn "GitOps branch contains a Git URL: $GITOPS_COMMIT_BRANCH"
    warn "Fix: branch should be main/master/develop; URL belongs in GitOps repo clone URL."
    fail=1
  fi

  if ! looks_like_git_url "${GITOPS_COMMIT_REPO_URL:-}"; then
    warn "GitOps repo clone URL does not look like a Git URL: ${GITOPS_COMMIT_REPO_URL:-unset}"
    fail=1
  fi

  (( fail == 0 ))
}

