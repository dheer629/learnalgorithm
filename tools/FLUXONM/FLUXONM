GIT_PROVIDER="${GIT_PROVIDER:-generic}"             # github | generic
GITHUB_OWNER="${GITHUB_OWNER:-}"
GITHUB_REPO="${GITHUB_REPO:-}"
GITHUB_BRANCH="${GITHUB_BRANCH:-main}"
GITHUB_PATH="${GITHUB_PATH:-clusters/dev}"
GITHUB_TOKEN="${GITHUB_TOKEN:-}"

REPO_URL="${REPO_URL:-}"
REPO_BRANCH="${REPO_BRANCH:-main}"
REPO_PATH="${REPO_PATH:-clusters/dev}"
REPO_NAME="${REPO_NAME:-dheer-gitops-repo}"
KUSTOMIZATION_NAME="${KUSTOMIZATION_NAME:-dheer-gitops}"

SYNC_INTERVAL="${SYNC_INTERVAL:-1m}"
RETRY_INTERVAL="${RETRY_INTERVAL:-30s}"
TIMEOUT="${TIMEOUT:-5m}"

ASSUME_YES=0
VERBOSE=0
NO_COLOR="${NO_COLOR:-0}"
JSON_OUT=0

# ------------------------------------------------------------------------------
# Colors
# ------------------------------------------------------------------------------

if [[ "$NO_COLOR" == "1" || ! -t 1 ]]; then
  C_RESET=""; C_BOLD=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""; C_MAGENTA=""; C_GREY=""; C_BLUE=""; C_WHITE=""
else
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_CYAN=$'\033[36m'
  C_MAGENTA=$'\033[35m'
  C_GREY=$'\033[90m'
  C_BLUE=$'\033[34m'
  C_WHITE=$'\033[97m'
fi

# ------------------------------------------------------------------------------
# Logging / Audit
# ------------------------------------------------------------------------------

strip_ansi() { sed 's/\x1b\[[0-9;]*m//g'; }

log_file() {
  printf '%s %s\n' "$(date '+%F %T')" "$(strip_ansi <<<"$*")" >> "$LOG_FILE" 2>/dev/null || true
}

audit() {
  local action="${1:-unknown}"
  shift || true
  printf '%s|user=%s|mode=%s|context=%s|namespace=%s|action=%s|%s\n' \
    "$(date -Is)" "${USER:-unknown}" "$MODE" "${KUBE_CONTEXT:-unset}" "${ACTIVE_NAMESPACE:-unset}" "$action" "$*" >> "$AUDIT_FILE" 2>/dev/null || true
}

info()  { log_file "INFO  $*"; [[ "$JSON_OUT" == "1" ]] || printf '%b\n' "${C_CYAN}ℹ${C_RESET}  $*"; }
ok()    { log_file "OK    $*"; [[ "$JSON_OUT" == "1" ]] || printf '%b\n' "${C_GREEN}✔${C_RESET}  ${C_BOLD}$*${C_RESET}"; }
warn()  { log_file "WARN  $*"; [[ "$JSON_OUT" == "1" ]] || printf '%b\n' "${C_YELLOW}⚠${C_RESET}  $*" >&2; }
err()   { log_file "ERROR $*"; [[ "$JSON_OUT" == "1" ]] || printf '%b\n' "${C_RED}✘${C_RESET}  ${C_BOLD}$*${C_RESET}" >&2; }
debug() { [[ "$VERBOSE" == "1" ]] || return 0; log_file "DEBUG $*"; printf '%b\n' "${C_GREY}… $*${C_RESET}"; }
step()  { log_file "STEP  $*"; [[ "$JSON_OUT" == "1" ]] || printf '\n%b\n' "${C_MAGENTA}${C_BOLD}▶ $*${C_RESET}"; }
die()   { err "$1"; exit "${2:-1}"; }

on_error() {
  local rc=$?
  local line="${1:-unknown}"
  err "Failed at line $line with exit code $rc"
  warn "Log: $LOG_FILE"
  warn "Output directory: $OUTDIR"
  exit "$rc"
}
trap 'on_error $LINENO' ERR

# ------------------------------------------------------------------------------
# Terminal UI primitives
# ------------------------------------------------------------------------------

term_width() {
  local w
  w="$(tput cols 2>/dev/null || echo 120)"
  (( w < 96 )) && w=96
  (( w > 160 )) && w=160
  echo "$w"
}

repeat_char() {
  local char="$1"
  local count="$2"
  local out=""
  local i
  for ((i=0; i<count; i++)); do out="${out}${char}"; done
  printf '%s' "$out"
}

clear_screen() {
  [[ -t 1 ]] && command -v clear >/dev/null 2>&1 && clear || true
}

box_line() {
  local text="${1:-}"
  local width="${2:-$(term_width)}"
  local inner=$((width-4))
  printf '%b║%b %-*.*s %b║%b\n' "$C_CYAN" "$C_RESET" "$inner" "$inner" "$text" "$C_CYAN" "$C_RESET"
}

box_top() {
  local width="${1:-$(term_width)}"
  printf '%b╔%s╗%b\n' "$C_CYAN" "$(repeat_char "═" $((width-2)))" "$C_RESET"
}

box_mid() {
  local width="${1:-$(term_width)}"
  printf '%b╠%s╣%b\n' "$C_CYAN" "$(repeat_char "═" $((width-2)))" "$C_RESET"
}

box_bottom() {
  local width="${1:-$(term_width)}"
  printf '%b╚%s╝%b\n' "$C_CYAN" "$(repeat_char "═" $((width-2)))" "$C_RESET"
}

mini_bar() {
  local width
  width="$(term_width)"
  printf '%b%s%b\n' "$C_GREY" "$(repeat_char "─" "$width")" "$C_RESET"
}

mode_badge_text() {
  if [[ "$MODE" == "MANAGEMENT" ]]; then
    echo "MANAGEMENT"
  else
    echo "SUPERVISION"
  fi
}

mode_badge_color() {
  if [[ "$MODE" == "MANAGEMENT" ]]; then
    printf '%bMANAGEMENT%b' "$C_RED$C_BOLD" "$C_RESET"
  else
    printf '%bSUPERVISION%b' "$C_GREEN$C_BOLD" "$C_RESET"
  fi
}

banner() {
  [[ "$JSON_OUT" == "1" ]] && return 0
  local w
  w="$(term_width)"
  box_top "$w"
  box_line "" "$w"
  box_line "   FLUXONM Command Center" "$w"
  box_line "   Kubernetes · vCluster · Flux · Lifecycle · Observability" "$w"
  box_line "   Production Control Plane · Supervision First · Management Gated" "$w"
  box_line "" "$w"
  box_bottom "$w"
  printf '%bversion %s · host %s · run %s%b\n' "$C_GREY" "$SCRIPT_VERSION" "$(hostname 2>/dev/null || echo n/a)" "$RUN_ID" "$C_RESET"
}

status_header() {
  load_prefs >/dev/null 2>&1 || true
  local mode_text
  mode_text="$(mode_badge_text)"
  local ctx="${KUBE_CONTEXT:-$(current_context 2>/dev/null || echo unset)}"
  local w
  w="$(term_width)"

  box_top "$w"
  box_line " MODE ${mode_text}  │ CONTEXT ${ctx}  │ NAMESPACE ${LOCKED_NAMESPACE}  │ FLUX ${FLUX_NAMESPACE}" "$w"
  box_line " KUBECONFIG ${KUBECONFIG_PATH}" "$w"
  box_line " OUTPUT ${OUTDIR}" "$w"
  box_bottom "$w"
}


header() {
  clear_screen
  banner
  status_header
}

hotkey_bar_supervision() {
  printf '%b%s%b\n' "$C_YELLOW" "[h]Health [s]Status [A]AppRun [F]Forward [O]History [Q]QuickFilter [v]vCluster [f]Flux [x]Diag [c]Ctx/NS [/]Palette [m]Mgmt [q]Quit" "$C_RESET"
}

hotkey_bar_management() {
  printf '%b%s%b\n' "$C_RED" "[v]vCluster [f]Flux [o]GitOps [r]Restart [z]Scale [p]PodDelete [P]ForcePod [c]Ctx/NS [l]Lock [e]Prefs [s]Supervision [q]Quit" "$C_RESET"
}

pause_return() {
  echo
  read -r -p "Press Enter to continue..." _ || true
}

section() {
  echo
  printf '%b┌─ %s %b\n' "$C_CYAN$C_BOLD" "$1" "$C_RESET"
}

viewer() {
  local file="$1"
  [[ -s "$file" ]] || { warn "File empty or missing: $file"; return 0; }
  if command -v less >/dev/null 2>&1 && [[ -t 1 ]]; then
    LESS='-R -S -i -M --use-color' less "$file"
  else
    cat "$file"
  fi
}

