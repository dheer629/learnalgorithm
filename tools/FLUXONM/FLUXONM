sanitize_dns_name() {
  local raw="${1:-app}"
  printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/--+/-/g' | cut -c1-63
}


