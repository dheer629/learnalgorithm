#!/usr/bin/env bash
# ==============================================================================
# Dheer_K8s_Command_Center.sh
# ==============================================================================
# Ultra Pro Max Kubernetes / vCluster / Flux Command Center
#
# Inspired by K9s / Bloomberg terminal style dashboards:
#   - Boxed panels
#   - Hotkeys
#   - Command palette
#   - Supervision mode by default
#   - Management mode gated
#   - Context/server/namespace lock
#   - Full searchable logs; no --tail truncation in log viewer
#   - Timestamped output capture
#   - Audit trail
#
# Supported:
#   - Ubuntu / WSL / RHEL-like Linux
#   - vCluster in Docker
#   - Any Kubernetes cluster reachable through kubeconfig
#   - Flux v2.x, default pinned CLI v2.4.0 for Kubernetes v1.30.x compatibility
#
# ==============================================================================

set -Eeuo pipefail
IFS=$'\n\t'

SCRIPT_NAME="$(basename "$0")"
SCRIPT_VERSION="6.7.0-vcluster-persistence-restore"

STATE_DIR="${STATE_DIR:-$HOME/.Dheer_K8s_Command_Center}"
