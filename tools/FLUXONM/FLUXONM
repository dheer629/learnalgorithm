git_clone_with_configured_auth() {
  local repo_url="$1"
  local branch="$2"
  local dest="$3"

  rm -rf "$dest"

  if [[ "${GIT_AUTH_MODE:-basic}" == "ssh" ]]; then
    [[ -n "${GIT_PRIVATE_KEY_FILE:-}" ]] || die "SSH private key file missing"
    GIT_SSH_COMMAND="ssh -i ${GIT_PRIVATE_KEY_FILE} -o StrictHostKeyChecking=accept-new" \
      git clone --branch "$branch" "$repo_url" "$dest"
    return $?
  fi

  local askpass
  askpass="$(mktemp)"
  cat > "$askpass" <<'ASKPASS'
#!/usr/bin/env bash
case "$1" in
  *Username*) printf '%s\n' "${GIT_USERNAME:-git}" ;;
  *Password*) printf '%s\n' "${GIT_TOKEN:-${GITHUB_TOKEN:-}}" ;;
  *) printf '\n' ;;
esac
ASKPASS
  chmod 700 "$askpass"

  GIT_USERNAME="${GIT_USERNAME:-git}" \
  GIT_TOKEN="${GIT_TOKEN:-${GITHUB_TOKEN:-}}" \
  GITHUB_TOKEN="${GITHUB_TOKEN:-${GIT_TOKEN:-}}" \
  GIT_ASKPASS="$askpass" \
  GIT_TERMINAL_PROMPT=0 \
    git clone --branch "$branch" "$repo_url" "$dest"

  local rc=$?
  rm -f "$askpass"
  return $rc
}

git_push_with_configured_auth() {
  local repo_dir="$1"
  local branch="$2"

  if [[ "${GIT_AUTH_MODE:-basic}" == "ssh" ]]; then
    [[ -n "${GIT_PRIVATE_KEY_FILE:-}" ]] || die "SSH private key file missing"
    GIT_SSH_COMMAND="ssh -i ${GIT_PRIVATE_KEY_FILE} -o StrictHostKeyChecking=accept-new" \
      git -C "$repo_dir" push origin "$branch"
    return $?
  fi

  local askpass
  askpass="$(mktemp)"
  cat > "$askpass" <<'ASKPASS'
#!/usr/bin/env bash
case "$1" in
  *Username*) printf '%s\n' "${GIT_USERNAME:-git}" ;;
  *Password*) printf '%s\n' "${GIT_TOKEN:-${GITHUB_TOKEN:-}}" ;;
  *) printf '\n' ;;
esac
ASKPASS
  chmod 700 "$askpass"

  GIT_USERNAME="${GIT_USERNAME:-git}" \
  GIT_TOKEN="${GIT_TOKEN:-${GITHUB_TOKEN:-}}" \
  GITHUB_TOKEN="${GITHUB_TOKEN:-${GIT_TOKEN:-}}" \
  GIT_ASKPASS="$askpass" \
  GIT_TERMINAL_PROMPT=0 \
    git -C "$repo_dir" push origin "$branch"

  local rc=$?
  rm -f "$askpass"
  return $rc
}

cmd_flux_repair_gotk_path() {
  require_management
  sync_gitops_bootstrap_vars

  [[ -n "${GIT_URL:-}" ]] || die "GIT_URL missing. Set git_url first."
  [[ -n "${GIT_BRANCH:-}" ]] || die "GIT_BRANCH missing. Set git_branch first."
  [[ -n "${GIT_PATH:-}" ]] || die "GIT_PATH missing. Set git_path first."

  if [[ "${GIT_AUTH_MODE:-basic}" != "ssh" ]]; then
    [[ -n "${GIT_TOKEN:-${GITHUB_TOKEN:-}}" ]] || die "Git token missing. Run: FLUXONM --mode management git-token-prompt"
  fi

  section "Repair missing Flux source-of-truth files"
  echo "Repo        : $GIT_URL"
  echo "Branch      : $GIT_BRANCH"
  echo "Flux path   : $GIT_PATH"
  echo "Namespace   : $FLUX_NAMESPACE"
  echo "Auth mode   : ${GIT_AUTH_MODE:-basic}"
  echo "Username    : ${GIT_USERNAME:-git}"
  echo
  echo "This will regenerate and commit:"
  echo "  $GIT_PATH/gotk-components.yaml"
  echo "  $GIT_PATH/gotk-sync.yaml"
  echo "  $GIT_PATH/kustomization.yaml"
  echo
  echo "This will NOT commit backup files (*.bak.fluxonm.*)."
  echo
  read -r -p "Proceed with gotk path repair? [Y/n]: " ans || true
  ans="${ans:-Y}"
  [[ "$ans" =~ ^[Yy]$ ]] || { warn "Repair cancelled"; return 0; }

  local work repo_dir sync_dir
  work="$(mktemp -d)"
  repo_dir="$work/repo"

  section "Clone GitOps repo"
  echo "Cloning $GIT_URL branch $GIT_BRANCH into temporary workdir"
  git_clone_with_configured_auth "$GIT_URL" "$GIT_BRANCH" "$repo_dir"

  sync_dir="$repo_dir/$GIT_PATH"
  mkdir -p "$sync_dir"

  section "Generate gotk-components.yaml"
  flux install --namespace="$FLUX_NAMESPACE" --export > "$sync_dir/gotk-components.yaml"

  section "Generate gotk-sync.yaml"
  {
    flux create source git flux-system \
      --url="$GIT_URL" \
      --branch="$GIT_BRANCH" \
      --interval="${SYNC_INTERVAL:-1m}" \
      --namespace="$FLUX_NAMESPACE" \
      --export

    echo "---"

    flux create kustomization flux-system \
      --source=GitRepository/flux-system \
      --path="./$GIT_PATH" \
      --prune=true \
      --interval="${SYNC_INTERVAL:-1m}" \
      --timeout="${TIMEOUT:-5m}" \
      --namespace="$FLUX_NAMESPACE" \
      --export
  } > "$sync_dir/gotk-sync.yaml"

  section "Generate root kustomization.yaml"
  if [[ -f "$sync_dir/kustomization.yaml" ]]; then
    cp "$sync_dir/kustomization.yaml" "$OUTDIR/kustomization.yaml.backup.$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
  fi

  {
    echo "apiVersion: kustomize.config.k8s.io/v1beta1"
    echo "kind: Kustomization"
    echo "resources:"
    echo "  - gotk-components.yaml"
    echo "  - gotk-sync.yaml"

    if [[ -d "$sync_dir/apps" ]]; then
      while IFS= read -r app_dir; do
        [[ -n "$app_dir" ]] || continue
        echo "  - apps/$(basename "$app_dir")"
      done < <(find "$sync_dir/apps" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
    fi
  } > "$sync_dir/kustomization.yaml"

  # Do not accidentally commit backup files created by older versions.
  find "$sync_dir" -maxdepth 1 -type f -name '*.bak.fluxonm.*' -delete 2>/dev/null || true

  section "Git diff preview"
  git -C "$repo_dir" status --short
  echo
  git -C "$repo_dir" diff -- "$GIT_PATH" || true

  echo
  read -r -p "Commit and push gotk path repair? [Y/n]: " commit_ans || true
  commit_ans="${commit_ans:-Y}"
  [[ "$commit_ans" =~ ^[Yy]$ ]] || { warn "Commit skipped"; return 0; }

  git -C "$repo_dir" config user.name "${GITOPS_COMMIT_USER_NAME:-FLUXONM Bot}"
  git -C "$repo_dir" config user.email "${GITOPS_COMMIT_USER_EMAIL:-fluxonm@example.local}"

  git -C "$repo_dir" add "$GIT_PATH/gotk-components.yaml" "$GIT_PATH/gotk-sync.yaml" "$GIT_PATH/kustomization.yaml"

  if git -C "$repo_dir" diff --cached --quiet; then
    ok "No changes to commit"
  else
    git -C "$repo_dir" commit -m "Repair Flux source-of-truth files under $GIT_PATH"
    section "Push GitOps repair commit"
    git_push_with_configured_auth "$repo_dir" "$GIT_BRANCH"
  fi

  section "Apply and reconcile"
  kubectl_ctx apply -f "$sync_dir/gotk-components.yaml"
  kubectl_ctx apply -f "$sync_dir/gotk-sync.yaml"

  flux_ctx reconcile source git flux-system -n "$FLUX_NAMESPACE" || true
  flux_ctx reconcile kustomization flux-system -n "$FLUX_NAMESPACE" --with-source || true

  ok "GOTK path repair completed"

  echo
  echo "Next:"
  echo "  FLUXONM flux-status"
  echo "  FLUXONM flux-trace"
  echo "  FLUXONM --mode management public-repo-deploy"
}

