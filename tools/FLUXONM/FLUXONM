cmd_doctor() {
  header
  require_supervision
  step "Doctor"

  local fail=0
  for c in kubectl helm vcluster flux jq curl git; do
    if command -v "$c" >/dev/null 2>&1; then ok "$c present"; else warn "$c missing"; fail=1; fi
  done

  kubectl_ctx get nodes -o wide || fail=1
  kubectl_ctx get ns "$ACTIVE_NAMESPACE" || warn "Namespace $ACTIVE_NAMESPACE not present"
  flux_ctx check --pre || true

  (( fail == 0 )) || die "Doctor found issues"
  ok "Doctor complete"
}

cmd_status() {
  header
  require_supervision
  section "Kubernetes"
  kubectl_ctx get nodes -o wide || true
  section "Namespace: $ACTIVE_NAMESPACE"
  kubectl_ctx get all -n "$ACTIVE_NAMESPACE" -o wide || true
  section "vCluster"
  vcluster list 2>/dev/null || true
  section "Flux"
  if kubectl_ctx get ns "$FLUX_NAMESPACE" >/dev/null 2>&1; then
    kubectl_ctx get pods -n "$FLUX_NAMESPACE" -o wide || true
    flux_ctx get all -A || true
  else
    warn "Flux namespace not found: $FLUX_NAMESPACE"
  fi
}

