# ------------------------------------------------------------------------------
# v6.6 final override: port conflict detection + auto free-port selection
# ------------------------------------------------------------------------------

port_in_use() {
  local port="$1"

  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(:|\\])${port}$"
    return $?
  fi

  if command -v lsof >/dev/null 2>&1; then
    lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
    return $?
  fi

  if command -v netstat >/dev/null 2>&1; then
    netstat -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(:|\\])${port}$"
    return $?
  fi

  return 1
}

show_port_listener() {
  local port="$1"

  echo
  echo "Listener details for port $port:"

  if command -v ss >/dev/null 2>&1; then
    ss -ltnp 2>/dev/null | grep -E "(:|\\])${port}[[:space:]]" || true
  elif command -v lsof >/dev/null 2>&1; then
    lsof -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
  elif command -v netstat >/dev/null 2>&1; then
    netstat -ltnp 2>/dev/null | grep -E "(:|\\])${port}[[:space:]]" || true
  else
    echo "No ss/lsof/netstat command available to show listener process."
  fi
}

find_free_port() {
  local start_port="${1:-9898}"
  local max_port="${2:-9999}"
  local p

  for ((p=start_port; p<=max_port; p++)); do
    if ! port_in_use "$p"; then
      printf '%s' "$p"
      return 0
    fi
  done

  return 1
}

cmd_app_forward() {
  require_management

  local app_ns="${PUBLIC_APP_NAMESPACE:-podinfo-demo}"
  local app_svc="${PUBLIC_APP_SERVICE:-podinfo}"
  local requested_port="${PUBLIC_APP_LOCAL_PORT:-9898}"
  local local_port="$requested_port"
  local svc_port="${PUBLIC_APP_SERVICE_PORT:-9898}"
  local log_file=""

  section "Start Application Port-forward"
  echo "Namespace        : $app_ns"
  echo "Service          : $app_svc"
  echo "Requested port   : localhost:${requested_port} -> service/${app_svc}:${svc_port}"
  echo

  if [[ -f "$PF_STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    . "$PF_STATE_FILE" || true
    if port_forward_pid_alive "${PF_PID:-}"; then
      ok "FLUXONM port-forward already running"
      echo "PID: ${PF_PID}"
      echo "URL: http://localhost:${PF_LOCAL_PORT:-$requested_port}"
      echo "Log: ${PF_LOG_FILE:-unset}"
      return 0
    fi
    warn "Removing stale FLUXONM port-forward state"
    rm -f "$PF_STATE_FILE"
  fi

  kubectl_ctx get ns "$app_ns" >/dev/null 2>&1 || die "Namespace not found: $app_ns"
  kubectl_ctx get svc "$app_svc" -n "$app_ns" >/dev/null 2>&1 || die "Service not found: $app_ns/$app_svc"

  if port_in_use "$requested_port"; then
    warn "Requested local port is already in use: $requested_port"
    show_port_listener "$requested_port"

    local_port="$(find_free_port "$((requested_port + 1))" 9999)" || die "No free local port found between $((requested_port + 1)) and 9999"

    echo
    ok "Auto-selected next free local port: $local_port"
    echo "Forward will be:"
    echo "  http://localhost:${local_port} -> service/${app_svc}:${svc_port}"
  fi

  log_file="$PF_DIR/${app_ns}-${app_svc}-${local_port}.log"

  echo
  echo "Forward          : localhost:${local_port} -> service/${app_svc}:${svc_port}"
  echo "Log              : $log_file"
  echo

  mkdir -p "$PF_DIR"
  : > "$log_file"

  build_kubectl_base_array
  local cmd=("${KUBECTL_BASE[@]}" port-forward -n "$app_ns" "svc/$app_svc" "${local_port}:${svc_port}")

  echo "Command preview:"
  printf '  %q ' "${cmd[@]}"
  echo

  nohup "${cmd[@]}" > "$log_file" 2>&1 &

  local pid=$!
  sleep 2

  cat > "$PF_STATE_FILE" <<EOF
PF_PID="$pid"
PF_NAMESPACE="$app_ns"
PF_SERVICE="$app_svc"
PF_LOCAL_PORT="$local_port"
PF_SERVICE_PORT="$svc_port"
PF_LOG_FILE="$log_file"
PF_STARTED_AT="$(date -Is)"
PF_COMMAND="$(printf '%q ' "${cmd[@]}")"
EOF

  if port_forward_pid_alive "$pid"; then
    ok "Port-forward started: PID $pid"
    echo "URL: http://localhost:${local_port}"
    echo "Log: $log_file"
    echo
    tail -20 "$log_file" || true
  else
    warn "Port-forward process exited. Check log: $log_file"
    cat "$log_file" || true
    rm -f "$PF_STATE_FILE"
    return 1
  fi
}

cmd_app_forward_stop() {
  require_management

  section "Stop Application Port-forward"

  if [[ ! -f "$PF_STATE_FILE" ]]; then
    warn "No FLUXONM port-forward state file found."
    echo
    echo "If port 9898 is still busy, inspect manually:"
    echo "  ss -ltnp | grep ':9898'"
    return 0
  fi

  # shellcheck disable=SC1090
  . "$PF_STATE_FILE"

  if port_forward_pid_alive "${PF_PID:-}"; then
    kill "$PF_PID" >/dev/null 2>&1 || true
    sleep 1
    if port_forward_pid_alive "$PF_PID"; then
      kill -9 "$PF_PID" >/dev/null 2>&1 || true
    fi
    ok "Stopped FLUXONM port-forward PID: $PF_PID"
  else
    warn "Port-forward PID not running: ${PF_PID:-unset}"
  fi

  rm -f "$PF_STATE_FILE"
}

cmd_app_port_check() {
  header
  require_supervision

  local port="${1:-${PUBLIC_APP_LOCAL_PORT:-9898}}"

  section "Port Check"
  echo "Port: $port"

  if port_in_use "$port"; then
    warn "Port is in use: $port"
    show_port_listener "$port"
    echo
    local next
    next="$(find_free_port "$((port + 1))" 9999)" || true
    [[ -n "$next" ]] && echo "Next free port: $next"
  else
    ok "Port is free: $port"
  fi
}

cmd_app_forward_force_9898() {
  require_management

  section "Force cleanup for port 9898"

  if [[ -f "$PF_STATE_FILE" ]]; then
    cmd_app_forward_stop || true
  fi

  if port_in_use 9898; then
    warn "Port 9898 is still in use by an external process."
    show_port_listener 9898
    echo
    echo "FLUXONM will not kill unknown external processes automatically."
    echo "Use the listener details above to stop the correct process, or let FLUXONM auto-select another port:"
    echo "  FLUXONM --mode management app-forward"
    return 1
  fi

  PUBLIC_APP_LOCAL_PORT=9898 cmd_app_forward
}


# ------------------------------------------------------------------------------
# v6.7 vCluster persistence / restore lifecycle
# ------------------------------------------------------------------------------

vcluster_container_name() {
  printf '%s.%s' "${VCLUSTER_CONTAINER_PREFIX:-vcluster.cp}" "${VCLUSTER_NAME:-dev}"
}

cmd_vcluster_persistence_status() {
  header
  require_supervision

  local cname
  cname="$(vcluster_container_name)"

  {
    section "vCluster Persistence Status"
    echo "vCluster name       : ${VCLUSTER_NAME:-dev}"
    echo "Expected container  : $cname"
    echo "State directory     : ${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}"
    echo "Kubeconfig          : ${VCLUSTER_KUBECONFIG:-$HOME/.kube/${VCLUSTER_NAME:-dev}.kubeconfig}"
    echo

    section "Docker Container"
    if docker ps -a --format '{{.Names}}' | grep -qx "$cname"; then
      docker ps -a --filter "name=^/${cname}$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
      echo
      docker inspect "$cname" --format 'RestartPolicy={{.HostConfig.RestartPolicy.Name}} State={{.State.Status}} StartedAt={{.State.StartedAt}}' 2>/dev/null || true
    else
      warn "vCluster container not found: $cname"
    fi

    section "Docker Volumes"
    docker volume ls --format '{{.Name}}' | grep -E "^${cname//./\\.}" || warn "No matching vCluster Docker volumes found for $cname"

    section "Local State Directory"
    if [[ -d "${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}" ]]; then
      du -sh "${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}" 2>/dev/null || true
      find "${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}" -maxdepth 3 -type d 2>/dev/null | head -50 || true
    else
      warn "State directory not found: ${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}"
    fi

    section "Kubernetes Reachability"
    if [[ -s "${VCLUSTER_KUBECONFIG:-$HOME/.kube/${VCLUSTER_NAME:-dev}.kubeconfig}" ]]; then
      kubectl --kubeconfig "${VCLUSTER_KUBECONFIG:-$HOME/.kube/${VCLUSTER_NAME:-dev}.kubeconfig}" get nodes -o wide || true
      kubectl --kubeconfig "${VCLUSTER_KUBECONFIG:-$HOME/.kube/${VCLUSTER_NAME:-dev}.kubeconfig}" get ns || true
    else
      warn "vCluster kubeconfig not found"
    fi

    section "Flux/App Status"
    kubectl --kubeconfig "${VCLUSTER_KUBECONFIG:-$HOME/.kube/${VCLUSTER_NAME:-dev}.kubeconfig}" get pods -n "${FLUX_NAMESPACE:-flux-system}" -o wide 2>/dev/null || true
    kubectl --kubeconfig "${VCLUSTER_KUBECONFIG:-$HOME/.kube/${VCLUSTER_NAME:-dev}.kubeconfig}" get gitrepositories,kustomizations -n "${FLUX_NAMESPACE:-flux-system}" -o wide 2>/dev/null || true
    kubectl --kubeconfig "${VCLUSTER_KUBECONFIG:-$HOME/.kube/${VCLUSTER_NAME:-dev}.kubeconfig}" get all -n "${PUBLIC_APP_NAMESPACE:-podinfo-demo}" -o wide 2>/dev/null || true
  } | capture_block "vcluster-persistence-status"
}

cmd_vcluster_set_restart_policy() {
  require_management

  local cname
  cname="$(vcluster_container_name)"

  section "Set Docker restart policy for vCluster"
  echo "Container      : $cname"
  echo "Restart policy : unless-stopped"
  echo

  if ! docker ps -a --format '{{.Names}}' | grep -qx "$cname"; then
    die "Container not found: $cname"
  fi

  docker update --restart unless-stopped "$cname"
  ok "Restart policy set: $cname -> unless-stopped"

  docker inspect "$cname" --format '{{.Name}} restart={{.HostConfig.RestartPolicy.Name}}'
}

cmd_vcluster_set_restart_policy_all() {
  require_management

  section "Set Docker restart policy for all vCluster containers"

  local containers=()
  mapfile -t containers < <(docker ps -a --filter "name=vcluster" --format '{{.Names}}' 2>/dev/null || true)

  if [[ ${#containers[@]} -eq 0 ]]; then
    warn "No vCluster containers found"
    return 0
  fi

  local c
  for c in "${containers[@]}"; do
    [[ -n "$c" ]] || continue
    echo "Setting restart policy: $c"
    docker update --restart unless-stopped "$c" >/dev/null
    docker inspect "$c" --format '{{.Name}} restart={{.HostConfig.RestartPolicy.Name}}'
  done
}

cmd_vcluster_restore() {
  require_management

  local cname kubeout wait_seconds
  cname="$(vcluster_container_name)"
  kubeout="${VCLUSTER_KUBECONFIG:-$HOME/.kube/${VCLUSTER_NAME:-dev}.kubeconfig}"
  wait_seconds="${VCLUSTER_RESTORE_WAIT_SECONDS:-60}"

  {
    section "Restore vCluster after Ubuntu/Windows restart"
    echo "vCluster name       : ${VCLUSTER_NAME:-dev}"
    echo "Container           : $cname"
    echo "Kubeconfig output   : $kubeout"
    echo "Wait seconds        : $wait_seconds"
    echo "State directory     : ${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}"
    echo

    section "Docker readiness"
    docker version

    section "Start container if present"
    if docker ps -a --format '{{.Names}}' | grep -qx "$cname"; then
      docker start "$cname" >/dev/null || true
      docker update --restart unless-stopped "$cname" >/dev/null || true
      docker ps -a --filter "name=^/${cname}$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    else
      warn "Container not found: $cname"
      echo "If state is missing, create it with:"
      echo "  FLUXONM --mode management vcluster-create"
      return 1
    fi

    section "Regenerate kubeconfig"
    mkdir -p "$HOME/.kube"

    if command -v vcluster >/dev/null 2>&1; then
      vcluster connect "${VCLUSTER_NAME:-dev}" --print > "$kubeout" 2>/tmp/fluxonm-vcluster-connect.err || {
        warn "vcluster connect failed; showing error:"
        cat /tmp/fluxonm-vcluster-connect.err || true
      }
    else
      warn "vcluster CLI not found"
    fi

    section "Wait for Kubernetes API"
    local end now ok_api=0
    end=$((SECONDS + wait_seconds))
    while (( SECONDS < end )); do
      if kubectl --kubeconfig "$kubeout" get nodes >/dev/null 2>&1; then
        ok_api=1
        break
      fi
      sleep 3
    done

    if [[ "$ok_api" == "1" ]]; then
      ok "vCluster API reachable"
      kubectl --kubeconfig "$kubeout" get nodes -o wide
    else
      warn "vCluster API not reachable within ${wait_seconds}s"
      kubectl --kubeconfig "$kubeout" get nodes -o wide || true
    fi

    section "Validate Flux"
    kubectl --kubeconfig "$kubeout" get pods -n "${FLUX_NAMESPACE:-flux-system}" -o wide 2>/dev/null || true
    kubectl --kubeconfig "$kubeout" get gitrepositories,kustomizations -n "${FLUX_NAMESPACE:-flux-system}" -o wide 2>/dev/null || true

    section "Validate app"
    kubectl --kubeconfig "$kubeout" get all -n "${PUBLIC_APP_NAMESPACE:-podinfo-demo}" -o wide 2>/dev/null || true

    section "Update FLUXONM preferences"
    KUBECONFIG_PATH="$kubeout"
    KUBE_CONTEXT="$(kubectl --kubeconfig "$kubeout" config current-context 2>/dev/null || echo "${KUBE_CONTEXT:-}")"
    LOCKED_CONTEXT="$KUBE_CONTEXT"
    VCLUSTER_KUBECONFIG="$kubeout"
    save_prefs

    ok "vCluster restore completed"
    echo
    echo "Next commands:"
    echo "  FLUXONM flux-status"
    echo "  FLUXONM public-repo-status"
    echo "  FLUXONM --mode management app-forward"
  } | tee "$VCLUSTER_RESTORE_LOG"

  local rc=${PIPESTATUS[0]}
  history_write_index "vcluster-restore" "$VCLUSTER_RESTORE_LOG" "$rc" 2>/dev/null || true
  history_append_master "vcluster-restore" "$VCLUSTER_RESTORE_LOG" "$rc" 2>/dev/null || true
  return "$rc"
}

cmd_vcluster_restore_install_shortcut() {
  require_management

  section "Install RESTORE_VCLUSTER shortcut"

  local target="/usr/local/bin/RESTORE_VCLUSTER"
  local source_path
  source_path="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"

  sudo tee "$target" >/dev/null <<EOF
#!/usr/bin/env bash
exec "$source_path" --mode management vcluster-restore "\$@"
EOF

  sudo chmod 0755 "$target"

  ok "Installed shortcut: $target"
  echo
  echo "After Windows/Ubuntu restart, run:"
  echo "  RESTORE_VCLUSTER"
}

cmd_vcluster_restore_setup() {
  require_management

  section "Production vCluster persistence setup"

  cmd_vcluster_set_restart_policy_all
  cmd_vcluster_restore_install_shortcut

  echo
  ok "Persistence setup completed"
  echo
  echo "Do not delete:"
  echo "  ${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}"
  echo "  Docker volumes matching: $(vcluster_container_name).*"
  echo
  echo "After restart:"
  echo "  RESTORE_VCLUSTER"
  echo "  FLUXONM public-repo-status"
}

cmd_vcluster_backup_state() {
  require_management

  local backup_dir="$STATE_DIR/backups"
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  local backup_file="$backup_dir/vcluster-state-${VCLUSTER_NAME:-dev}-${ts}.tar.gz"

  mkdir -p "$backup_dir"

  section "Backup vCluster local state"
  echo "State directory : ${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}"
  echo "Backup file     : $backup_file"

  if [[ ! -d "${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}" ]]; then
    die "State directory not found: ${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}"
  fi

  tar -czf "$backup_file" -C "$(dirname "${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}")" "$(basename "${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}")"

  ok "vCluster state backup created: $backup_file"
  ls -lh "$backup_file" || true
}

cmd_vcluster_safety_rules() {
  header
  require_supervision

  section "vCluster State Safety Rules"
  cat <<RULES
Do not delete these unless you intentionally want to reset the vCluster:

  ${VCLUSTER_STATE_DIR:-$HOME/.vcluster/docker}
  Docker container: $(vcluster_container_name)
  Docker volumes matching: $(vcluster_container_name).*

Avoid these destructive commands:

  rm -rf ~/.vcluster/docker/kubernetes/*
  rm -rf ~/.vcluster/docker/vcluster/*
  rm -rf ~/.vcluster/docker/vclusters/${VCLUSTER_NAME:-dev}
  docker rm -f $(vcluster_container_name)
  docker volume rm \$(docker volume ls -q | grep '$(vcluster_container_name)')

Recommended persistence commands:

  FLUXONM --mode management vcluster-persistence-setup
  RESTORE_VCLUSTER

RULES
}

# ------------------------------------------------------------------------------
# Args / Routing
# ------------------------------------------------------------------------------

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode)
        case "${2:-}" in
          supervision|SUPERVISION) MODE="SUPERVISION"; shift 2 ;;
          management|MANAGEMENT) MODE="MANAGEMENT"; shift 2 ;;
          *) die "--mode must be supervision or management" ;;
        esac
        ;;
      -y|--yes) ASSUME_YES=1; shift ;;
      -v|--verbose) VERBOSE=1; shift ;;
      --json) JSON_OUT=1; shift ;;
      --no-color) NO_COLOR=1; shift ;;
      -h|--help) COMMAND="help"; shift; return ;;
      *) break ;;
    esac
  done
  COMMAND="${1:-help}"
  shift || true
  COMMAND_ARGS=("$@")
}

main() {
  parse_args "$@"
  load_prefs

  case "$COMMAND" in
    help|-h|--help) usage ;;
    start) cmd_start ;;
    dashboard) cmd_dashboard ;;
    setup) cmd_setup ;;
    detect) cmd_detect ;;
    context-select) cmd_context_select ;;
    namespace-select) cmd_namespace_select ;;
    lock-init) cmd_lock_init ;;
    lock-show) cmd_lock_show ;;
    target-select) cmd_target_select ;;
    self-test) cmd_self_test ;;
    install-shortcut) cmd_install_shortcut ;;
    doctor|health) cmd_doctor ;;
    status) cmd_status ;;
    prefs) cmd_prefs ;;
    set) cmd_set "${COMMAND_ARGS[@]:-}" ;;
    edit-prefs) cmd_edit_prefs ;;

    k8s-status) cmd_k8s_status ;;
    k8s-pods) cmd_k8s_pods ;;
    k8s-events) cmd_k8s_events ;;
    k8s-logs) cmd_k8s_logs ;;
    k8s-describe) cmd_k8s_describe ;;
    k8s-yaml) cmd_k8s_yaml ;;
    k8s-top) cmd_k8s_top ;;
    quick-filter) cmd_quick_filter ;;

    k8s-rollout-restart) cmd_k8s_rollout_restart ;;
    k8s-scale) cmd_k8s_scale ;;
    pod-delete) cmd_pod_delete ;;
    pod-force-delete) cmd_pod_force_delete ;;

