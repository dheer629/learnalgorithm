cmd_gitops_validate() {
  operation_summary "GitOps validation"

  local fail=0

  command -v flux >/dev/null 2>&1 && ok "flux CLI present: $(flux --version 2>/dev/null || true)" || { warn "flux CLI missing"; fail=1; }
  kubectl_ctx get nodes >/dev/null 2>&1 && ok "Kubernetes target reachable" || { warn "Kubernetes target not reachable"; fail=1; }

  case "$GIT_PROVIDER" in
    github|gitlab|gitea)
      [[ -n "$GIT_OWNER" ]] || { warn "git owner/group missing"; fail=1; }
      [[ -n "$GIT_REPOSITORY" ]] || { warn "git repository missing"; fail=1; }
      [[ -n "$GIT_BRANCH" ]] || { warn "git branch missing"; fail=1; }
      [[ -n "$GIT_PATH" ]] || { warn "git path missing"; fail=1; }
      [[ "$GIT_AUTH_MODE" != "token" || -n "$GIT_TOKEN" ]] || { warn "token/PAT missing"; fail=1; }
      ;;
    bitbucket-server)
      [[ -n "$GIT_OWNER" ]] || { warn "Bitbucket project/user missing"; fail=1; }
      [[ -n "$GIT_REPOSITORY" ]] || { warn "Bitbucket repository missing"; fail=1; }
      [[ -n "$GIT_HOSTNAME" ]] || { warn "Bitbucket Server hostname missing"; fail=1; }
      [[ -n "$GIT_USERNAME" ]] || { warn "Bitbucket username missing"; fail=1; }
      [[ "$GIT_AUTH_MODE" != "token" || -n "$GIT_TOKEN" ]] || { warn "Bitbucket token missing"; fail=1; }
      ;;
    generic|azure-devops|aws-codecommit|google-cloud-source|bitbucket-cloud)
      [[ -n "$GIT_URL" ]] || { warn "git URL missing"; fail=1; }
      [[ -n "$GIT_BRANCH" ]] || { warn "git branch missing"; fail=1; }
      [[ -n "$GIT_PATH" ]] || { warn "git path missing"; fail=1; }
      if [[ "$GIT_AUTH_MODE" == "ssh" && -z "$GIT_PRIVATE_KEY_FILE" ]]; then
        warn "SSH auth selected but private key file is missing"
        fail=1
      fi
      ;;
    *)
      warn "Unsupported Git provider: $GIT_PROVIDER"
      fail=1
      ;;
  esac

  if (( fail == 0 )); then
    ok "GitOps prerequisites look ready"
  else
    warn "GitOps prerequisites incomplete"
    return 1
  fi
}

cmd_gitops_deploy() {
  require_management
  if [[ -n "${GITOPS_COMMIT_REPO_URL:-}" || -n "${GITOPS_COMMIT_BRANCH:-}" || -n "${GITOPS_COMMIT_PATH:-}" ]]; then
    sync_gitops_bootstrap_vars
  fi
  cmd_gitops_validate || die "GitOps validation failed"

  local cmd=()

  case "$GIT_PROVIDER" in
    github)
      export GITHUB_TOKEN="$GIT_TOKEN"
      cmd=(flux bootstrap github --owner="$GIT_OWNER" --repository="$GIT_REPOSITORY" --branch="$GIT_BRANCH" --path="$GIT_PATH" --namespace="$FLUX_NAMESPACE")
      [[ "$GIT_AUTH_MODE" == "token" ]] && cmd+=(--token-auth)
      [[ -n "$GIT_HOSTNAME" && "$GIT_HOSTNAME" != "github.com" ]] && cmd+=(--hostname="$GIT_HOSTNAME")
      [[ "$GIT_PERSONAL" == "true" ]] && cmd+=(--personal)
      [[ "$GIT_PRIVATE" == "false" ]] && cmd+=(--private=false)
      append_extra_flags cmd
      ;;
    gitlab)
      export GITLAB_TOKEN="$GIT_TOKEN"
      cmd=(flux bootstrap gitlab --owner="$GIT_OWNER" --repository="$GIT_REPOSITORY" --branch="$GIT_BRANCH" --path="$GIT_PATH" --namespace="$FLUX_NAMESPACE")
      [[ "$GIT_AUTH_MODE" == "token" ]] && cmd+=(--token-auth)
      [[ -n "$GIT_HOSTNAME" && "$GIT_HOSTNAME" != "gitlab.com" ]] && cmd+=(--hostname="$GIT_HOSTNAME")
      [[ "$GIT_PERSONAL" == "true" ]] && cmd+=(--personal)
      append_extra_flags cmd
      ;;
    gitea)
      export GITEA_TOKEN="$GIT_TOKEN"
      cmd=(flux bootstrap gitea --owner="$GIT_OWNER" --repository="$GIT_REPOSITORY" --branch="$GIT_BRANCH" --path="$GIT_PATH" --namespace="$FLUX_NAMESPACE")
      [[ "$GIT_AUTH_MODE" == "token" ]] && cmd+=(--token-auth)
      [[ -n "$GIT_HOSTNAME" ]] && cmd+=(--hostname="$GIT_HOSTNAME")
      [[ "$GIT_PERSONAL" == "true" ]] && cmd+=(--personal)
      append_extra_flags cmd
      ;;
    bitbucket-server)
      export BITBUCKET_TOKEN="$GIT_TOKEN"
      cmd=(flux bootstrap bitbucket-server --owner="$GIT_OWNER" --repository="$GIT_REPOSITORY" --branch="$GIT_BRANCH" --path="$GIT_PATH" --namespace="$FLUX_NAMESPACE" --hostname="$GIT_HOSTNAME" --username="$GIT_USERNAME")
      [[ "$GIT_AUTH_MODE" == "token" ]] && cmd+=(--token-auth)
      [[ "$GIT_PERSONAL" == "true" ]] && cmd+=(--personal)
      append_extra_flags cmd
      ;;
    generic|azure-devops|aws-codecommit|google-cloud-source|bitbucket-cloud)
      cmd=(flux bootstrap git --url="$GIT_URL" --branch="$GIT_BRANCH" --path="$GIT_PATH" --namespace="$FLUX_NAMESPACE")
      case "$GIT_AUTH_MODE" in
        ssh)
          cmd+=(--private-key-file="$GIT_PRIVATE_KEY_FILE")
          [[ -n "$GIT_PASSWORD" ]] && cmd+=(--password="$GIT_PASSWORD")
          ;;
        bearer)
          cmd+=(--password="$GIT_TOKEN" --with-bearer-token)
          ;;
        basic|token)
          cmd+=(--username="$GIT_USERNAME" --password="$GIT_TOKEN")
          ;;
        none)
          ;;
      esac
      append_extra_flags cmd
      ;;
  esac

  show_command_preview "Flux GitOps deploy" "${cmd[@]}"
  "${cmd[@]}"
  audit "gitops-deploy" "provider=$GIT_PROVIDER"
}

