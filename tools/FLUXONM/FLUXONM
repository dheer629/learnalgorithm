cmd_prefs() {
  load_prefs
  [[ -r "$PREF_FILE" ]] || { warn "No preferences found."; return 0; }
  sed 's/GITHUB_TOKEN=.*/GITHUB_TOKEN="***masked***"/' "$PREF_FILE" | sed 's/^/  /'
}

cmd_set() {
  require_management
  local key="${1:-}"
  local value="${2:-}"
  [[ -n "$key" && -n "$value" ]] || die "Usage: $SCRIPT_NAME --mode management set KEY VALUE"

  case "$key" in
    kubeconfig) KUBECONFIG_PATH="$value" ;;
    context) KUBE_CONTEXT="$value" ;;
    namespace) ACTIVE_NAMESPACE="$value"; LOCKED_NAMESPACE="$value" ;;
    flux_namespace) FLUX_NAMESPACE="$value" ;;
    vcluster_name) VCLUSTER_NAME="$value"; VCLUSTER_KUBECONFIG="$HOME/.kube/${value}.kubeconfig" ;;
    vcluster_version) VCLUSTER_K8S_VERSION="$value" ;;
    vcluster_distro) VCLUSTER_DISTRO="$value" ;;
    flux_cli_version) FLUX_CLI_VERSION="$value" ;;
    repo_url) REPO_URL="$value" ;;
    repo_branch) REPO_BRANCH="$value" ;;
    repo_path) REPO_PATH="$value" ;;
    repo_name) REPO_NAME="$value" ;;
    kustomization_name) KUSTOMIZATION_NAME="$value" ;;
    github_owner) GITHUB_OWNER="$value" ;;
    github_repo) GITHUB_REPO="$value" ;;
    github_branch) GITHUB_BRANCH="$value" ;;
    github_path) GITHUB_PATH="$value" ;;
    github_token) GITHUB_TOKEN="$value" ;;
    *) die "Unsupported key: $key" ;;
  esac

  save_prefs
  audit "set" "key=$key"
}

cmd_edit_prefs() {
  require_management
  [[ -r "$PREF_FILE" ]] || save_prefs
  "${EDITOR:-vi}" "$PREF_FILE"
  audit "edit-prefs"
}


# ------------------------------------------------------------------------------
# Ultra Pro Max operation preflight compatibility helpers
# ------------------------------------------------------------------------------

operation_summary() {
  local action="${1:-operation}"
  load_prefs >/dev/null 2>&1 || true

  echo
  printf '%b┌─ Operation Summary %b\n' "$C_CYAN$C_BOLD" "$C_RESET"
  printf '│ Action      : %s\n' "$action"
  printf '│ Mode        : %s\n' "$MODE"
  printf '│ Kubeconfig  : %s\n' "$KUBECONFIG_PATH"
  printf '│ Context     : %s\n' "${KUBE_CONTEXT:-$(current_context 2>/dev/null || echo unset)}"
  printf '│ Namespace   : %s\n' "$ACTIVE_NAMESPACE"
  printf '│ Flux NS     : %s\n' "$FLUX_NAMESPACE"
  printf '│ Output Dir  : %s\n' "$OUTDIR"
  printf '└──────────────────────────────────────────────────────────────────────────────\n'
}

confirm_read_operation() {
  local action="${1:-operation}"
  operation_summary "$action"

  # Dashboard read actions should not become annoying. Default is Yes.
  [[ "${DHEER_SKIP_READ_CONFIRM:-0}" == "1" ]] && return 0

  if [[ -t 0 ]]; then
    read -r -p "Run this supervision operation? [Y/n]: " ans || true
    ans="${ans:-Y}"
    [[ "$ans" =~ ^[Yy]$ ]]
  else
    return 0
  fi
}

resource_summary() {
  local title="${1:-Resource Summary}"
  echo
  printf '%b┌─ %s %b\n' "$C_CYAN$C_BOLD" "$title" "$C_RESET"

  if command -v kubectl >/dev/null 2>&1 && [[ -s "${KUBECONFIG_PATH:-}" ]]; then
    kubectl_ctx get pods -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | awk 'BEGIN{c=0}{c++}END{printf "│ Pods        : %s\n", c+0}' || true
    kubectl_ctx get deploy -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | awk 'BEGIN{c=0}{c++}END{printf "│ Deployments : %s\n", c+0}' || true
    kubectl_ctx get svc -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | awk 'BEGIN{c=0}{c++}END{printf "│ Services    : %s\n", c+0}' || true
    kubectl_ctx get events -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | awk 'BEGIN{c=0}{c++}END{printf "│ Events      : %s\n", c+0}' || true
  else
    printf '│ Kubernetes target not available yet\n'
  fi

  printf '└──────────────────────────────────────────────────────────────────────────────\n'
}

show_command_preview() {
  local title="$1"; shift
  echo
  printf '%b┌─ Command Preview: %s %b\n' "$C_YELLOW$C_BOLD" "$title" "$C_RESET"
  printf '│ '
  printf '%q ' "$@"
  echo
  printf '└──────────────────────────────────────────────────────────────────────────────\n'
}

quick_filter_items() {
  local pattern="$1"
  shift
  local item
  for item in "$@"; do
    if [[ -z "$pattern" || "$item" == *"$pattern"* ]]; then
      printf '%s\n' "$item"
    fi
  done
}

select_from_list() {
  local prompt="$1"; shift
  local original_items=("$@")
  local filtered_items=("${original_items[@]}")
  local filter=""
  local choice item i

  if [[ ${#original_items[@]} -eq 0 ]]; then
    warn "No resources available for selection."
    return 1
  fi

  while true; do
    echo
    printf '%b┌─ Selection: %s %b\n' "$C_CYAN$C_BOLD" "$prompt" "$C_RESET"
    printf '│ Total: %s | Showing: %s | Filter: %s\n' "${#original_items[@]}" "${#filtered_items[@]}" "${filter:-<none>}"
    printf '└──────────────────────────────────────────────────────────────────────────────\n'

    if [[ ${#filtered_items[@]} -eq 0 ]]; then
      warn "No matching resources for filter: $filter"
    else
      i=1
      for item in "${filtered_items[@]}"; do
        printf '  [%s] %s\n' "$i" "$item"
        i=$((i+1))
      done
    fi

    echo
    echo "Quick actions: /text filter | * clear | q cancel"
    read -r -p "$prompt: " choice || true

    case "$choice" in
      q|Q)
        warn "Selection cancelled."
        return 1
        ;;
      '*')
        filter=""
        filtered_items=("${original_items[@]}")
        continue
        ;;
      /*)
        filter="${choice#/}"
        mapfile -t filtered_items < <(quick_filter_items "$filter" "${original_items[@]}")
        continue
        ;;
      "")
        warn "No selection entered."
        continue
        ;;
      *)
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#filtered_items[@]} )); then
          echo "${filtered_items[$((choice-1))]}"
          return 0
        fi
        warn "Invalid selection: $choice"
        ;;
    esac
  done
}

select_k8s_resource_name() {
  local rtype="$1"
  local title="${2:-Select resource}"
  local items=()

  mapfile -t items < <(kubectl_ctx get "$rtype" -n "$ACTIVE_NAMESPACE" --no-headers 2>/dev/null | awk '{print $1}' | sort)

  if [[ ${#items[@]} -eq 0 ]]; then
    warn "No resources found: type=$rtype namespace=$ACTIVE_NAMESPACE"
    echo
    echo "Available resource summary:"
    kubectl_ctx get all -n "$ACTIVE_NAMESPACE" -o wide 2>/dev/null || true
    return 1
  fi

  select_from_list "$title" "${items[@]}"
}

# ------------------------------------------------------------------------------
# Context / Lock
# ------------------------------------------------------------------------------

export_kubeconfig() {
  export KUBECONFIG="$KUBECONFIG_PATH"
}

kubectl_ctx() {
  export_kubeconfig
  if [[ -n "$KUBE_CONTEXT" ]]; then
    kubectl --context "$KUBE_CONTEXT" "$@"
  else
    kubectl "$@"
  fi
}

flux_ctx() {
  export_kubeconfig
  if [[ -n "$KUBE_CONTEXT" ]]; then
    flux --context "$KUBE_CONTEXT" "$@"
  else
    flux "$@"
  fi
}

current_context() {
  export_kubeconfig
  if [[ -n "$KUBE_CONTEXT" ]]; then
    echo "$KUBE_CONTEXT"
  else
    kubectl config current-context 2>/dev/null || true
  fi
}

current_cluster_name() {
  local ctx="$1"
  export_kubeconfig
  kubectl config view -o jsonpath="{.contexts[?(@.name==\"${ctx}\")].context.cluster}" 2>/dev/null || true
}

current_cluster_server() {
  local ctx="$1"
  local cluster
  cluster="$(current_cluster_name "$ctx")"
  [[ -n "$cluster" ]] || return 0
  kubectl config view -o jsonpath="{.clusters[?(@.name==\"${cluster}\")].cluster.server}" 2>/dev/null || true
}

validate_lock() {
  load_prefs
  export_kubeconfig

  [[ -s "$KUBECONFIG_PATH" ]] || die "Kubeconfig not found: $KUBECONFIG_PATH"

  local ctx server
  ctx="$(current_context)"
  [[ -n "$ctx" ]] || die "No active kube context"

  server="$(current_cluster_server "$ctx")"
  [[ -n "$server" ]] || die "Unable to resolve cluster server for context $ctx"

  [[ -z "$LOCKED_CONTEXT" || "$ctx" == "$LOCKED_CONTEXT" ]] || die "Context lock mismatch: current=$ctx locked=$LOCKED_CONTEXT"
  [[ -z "$LOCKED_CLUSTER_SERVER" || "$server" == "$LOCKED_CLUSTER_SERVER" ]] || die "Cluster server lock mismatch"
  [[ "$ACTIVE_NAMESPACE" == "$LOCKED_NAMESPACE" ]] || die "Namespace lock mismatch: active=$ACTIVE_NAMESPACE locked=$LOCKED_NAMESPACE"
}

confirm_management() {
  [[ "$ASSUME_YES" == "1" ]] && return 0
  echo
  warn "MANAGEMENT action requested"
  info "Context   : ${LOCKED_CONTEXT}"
  info "Namespace : ${LOCKED_NAMESPACE}"
  read -r -p "Type MANAGEMENT to continue: " typed || true
  [[ "$typed" == "MANAGEMENT" ]]
}

require_supervision() {
  validate_lock
  if declare -F confirm_read_operation >/dev/null 2>&1; then
    confirm_read_operation "${FUNCNAME[1]:-supervision-operation}" || die "Operation cancelled"
  fi
}

require_management() {
  validate_lock
  if declare -F operation_summary >/dev/null 2>&1; then
    operation_summary "${FUNCNAME[1]:-management-operation}"
  fi
  [[ "$MODE" == "MANAGEMENT" ]] || die "Blocked. Use: $SCRIPT_NAME --mode management <command>"
  confirm_management || die "Management confirmation failed"
}

cmd_lock_init() {
  MODE="MANAGEMENT"
  load_prefs
  export_kubeconfig

  [[ -s "$KUBECONFIG_PATH" ]] || die "Kubeconfig not found: $KUBECONFIG_PATH"

  if [[ -z "$KUBE_CONTEXT" ]]; then
    KUBE_CONTEXT="$(kubectl config current-context 2>/dev/null || true)"
  fi
  [[ -n "$KUBE_CONTEXT" ]] || die "Cannot resolve context"

  LOCKED_CONTEXT="$KUBE_CONTEXT"
  LOCKED_CLUSTER_SERVER="$(current_cluster_server "$KUBE_CONTEXT")"

  read -r -p "Lock namespace [$ACTIVE_NAMESPACE]: " ns || true
  ACTIVE_NAMESPACE="${ns:-$ACTIVE_NAMESPACE}"
  LOCKED_NAMESPACE="$ACTIVE_NAMESPACE"

  save_prefs
  audit "lock-init" "context=$LOCKED_CONTEXT namespace=$LOCKED_NAMESPACE"
  ok "Execution lock initialized"
  cmd_lock_show
}

cmd_lock_show() {
  load_prefs
  echo "Kubeconfig     : $KUBECONFIG_PATH"
  echo "Context        : $KUBE_CONTEXT"
  echo "Cluster Server : $LOCKED_CLUSTER_SERVER"
  echo "Namespace      : $LOCKED_NAMESPACE"
  echo "Mode           : $MODE"
}

cmd_detect() {
  header
  step "Detect reachable Kubernetes contexts"

  local files=()
  [[ -n "${KUBECONFIG:-}" ]] && IFS=':' read -ra files <<< "$KUBECONFIG"
  [[ -f "$HOME/.kube/config" ]] && files+=("$HOME/.kube/config")
  while IFS= read -r f; do files+=("$f"); done < <(find "$HOME/.kube" -maxdepth 1 -type f -name "*.kubeconfig" 2>/dev/null || true)

  local found=0
  for file in "${files[@]}"; do
    [[ -s "$file" ]] || continue
    export KUBECONFIG="$file"
    while IFS= read -r ctx; do
      [[ -n "$ctx" ]] || continue
      if kubectl --context "$ctx" get nodes >/dev/null 2>&1; then
        echo "FOUND | kubeconfig=$file | context=$ctx | server=$(current_cluster_server "$ctx")"
        KUBECONFIG_PATH="$file"
        KUBE_CONTEXT="$ctx"
        found=1
      fi
    done < <(kubectl config get-contexts -o name 2>/dev/null || true)
  done

  if [[ "$found" == "1" ]]; then
    LOCKED_CONTEXT="$KUBE_CONTEXT"
    LOCKED_CLUSTER_SERVER="$(current_cluster_server "$KUBE_CONTEXT")"
    save_prefs
    ok "Detected and saved reachable context: $KUBE_CONTEXT"
  else
    warn "No reachable context detected"
  fi
}

# ------------------------------------------------------------------------------
# Captured execution / selection
# ------------------------------------------------------------------------------

run_capture() {
  local label="$1"; shift
  local safe_label out errf
  safe_label="$(tr -cs 'A-Za-z0-9._-' '_' <<<"$label" | sed 's/_$//')"
  out="$OUTDIR/${safe_label}.out"
  errf="$OUTDIR/${safe_label}.err"

  audit "run" "$label :: $*"

  {
    echo "### $label"
    echo "### $(date -Is)"
    echo "### command: $*"
    echo
    "$@"
  } >"$out" 2>"$errf" || {
    local rc=$?
    cat "$out"
    [[ -s "$errf" ]] && cat "$errf" >&2
    warn "Command failed rc=$rc output=$out error=$errf"
    return "$rc"
  }

  cat "$out"
  [[ -s "$errf" ]] && cat "$errf" >&2 || true
  info "Captured: $out"
}

select_from_list() {
  local prompt="$1"; shift
  local items=("$@")
  local i=1
  for item in "${items[@]}"; do
    printf '  [%s] %s\n' "$i" "$item"
    i=$((i+1))
  done
  read -r -p "$prompt: " choice || true
  [[ "$choice" =~ ^[0-9]+$ ]] || return 1
  (( choice >= 1 && choice <= ${#items[@]} )) || return 1
  echo "${items[$((choice-1))]}"
}

# ------------------------------------------------------------------------------
# Install
# ------------------------------------------------------------------------------

install_base_tools() {
  step "Install base tools"
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update -y
    sudo apt-get install -y curl ca-certificates git jq tar gzip unzip less procps
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y curl ca-certificates git jq tar gzip unzip less procps-ng
  elif command -v yum >/dev/null 2>&1; then
    sudo yum install -y curl ca-certificates git jq tar gzip unzip less procps-ng
  else
    warn "Unknown package manager. Install curl git jq tar gzip unzip less manually."
  fi
}

install_kubectl() {
  if command -v kubectl >/dev/null 2>&1; then ok "kubectl present"; return 0; fi
  step "Install kubectl"
  local stable tmp
  stable="$(curl -L -s https://dl.k8s.io/release/stable.txt)"
  tmp="$(mktemp)"
  curl -fL -o "$tmp" "https://dl.k8s.io/release/${stable}/bin/linux/amd64/kubectl"
  chmod +x "$tmp"
  sudo install -m 0755 "$tmp" /usr/local/bin/kubectl
  rm -f "$tmp"
}

install_helm() {
  if command -v helm >/dev/null 2>&1; then ok "helm present"; return 0; fi
  step "Install helm"
  curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
}

install_vcluster() {
  if command -v vcluster >/dev/null 2>&1; then ok "vcluster present: $(vcluster --version 2>/dev/null | head -1)"; return 0; fi
  step "Install vcluster"
  local ver="0.34.0" tmp
  tmp="$(mktemp)"
  curl -fL --retry 5 --retry-delay 5 --connect-timeout 20 --max-time 900 -o "$tmp" "https://github.com/loft-sh/vcluster/releases/download/v${ver}/vcluster-linux-amd64"
  chmod +x "$tmp"
  sudo install -m 0755 "$tmp" /usr/local/bin/vcluster
  rm -f "$tmp"
}

install_flux() {
  local wanted="${FLUX_CLI_VERSION#v}"
  if command -v flux >/dev/null 2>&1; then
    local current
    current="$(flux --version 2>/dev/null | awk '{print $3}' || true)"
    if [[ "$current" == "$wanted" || "$current" == "v$wanted" ]]; then
      ok "flux present: $(flux --version)"
      return 0
    fi
    warn "Flux CLI mismatch current=$(flux --version 2>/dev/null || true) wanted=v$wanted"
  fi

  step "Install Flux CLI v$wanted"
  local tmp
  tmp="$(mktemp -d)"
  curl -fL --retry 5 --retry-delay 5 --connect-timeout 20 --max-time 300 -o "$tmp/flux.tar.gz" "https://github.com/fluxcd/flux2/releases/download/v${wanted}/flux_${wanted}_linux_amd64.tar.gz"
  tar -xzf "$tmp/flux.tar.gz" -C "$tmp"
  sudo install -m 0755 "$tmp/flux" /usr/local/bin/flux
  rm -rf "$tmp"
  ok "flux installed: $(flux --version)"
}

cmd_setup() {
  header
  install_base_tools
  install_kubectl
  install_helm
  install_vcluster
  install_flux
  save_prefs
  ok "Setup complete"
}

