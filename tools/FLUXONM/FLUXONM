trim_one_line() {
  local v="${1:-}"
  # Remove CR, convert newlines/tabs to nothing/spaces, trim leading/trailing whitespace.
  v="$(printf '%s' "$v" | tr -d '\r' | tr -d '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  printf '%s' "$v"
}

read_branch_guarded() {
  local prompt="$1"
  local current="${2:-main}"
  local value=""

  while true; do
    value="$(read_value "$prompt" "$current")"
    value="$(trim_one_line "$value")"

    if looks_like_git_url "$value"; then
      warn "You entered a Git URL where a branch name is expected: $value"
      warn "Branch should be a simple value like: main, master, develop"
      printf '\n' >&2
      read -r -p "Use 'main' as branch and treat this as GitOps repo URL? [Y/n]: " fix || true
      fix="${fix:-Y}"
      if [[ "$fix" =~ ^[Yy]$ ]]; then
        GITOPS_COMMIT_REPO_URL="$value"
        value="main"
        break
      fi
      continue
    fi

    if looks_like_branch_name "$value"; then
      break
    fi

    warn "Invalid branch value: $value"
  done

  printf '%s' "$value"
}

