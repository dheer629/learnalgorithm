derive_gitops_commit_url() {
  if [[ -n "${GITOPS_COMMIT_REPO_URL:-}" ]]; then
    printf '%s' "$GITOPS_COMMIT_REPO_URL"
    return 0
  fi

  case "${GIT_PROVIDER:-generic}" in
    github)
      printf 'https://github.com/%s/%s.git' "$GIT_OWNER" "$GIT_REPOSITORY"
      ;;
    gitlab)
      local host="${GIT_HOSTNAME:-gitlab.com}"
      printf 'https://%s/%s/%s.git' "$host" "$GIT_OWNER" "$GIT_REPOSITORY"
      ;;
    gitea)
      local host="${GIT_HOSTNAME}"
      [[ -n "$host" ]] || return 1
      printf 'https://%s/%s/%s.git' "$host" "$GIT_OWNER" "$GIT_REPOSITORY"
      ;;
    *)
      [[ -n "${GIT_URL:-}" ]] && printf '%s' "$GIT_URL" || return 1
      ;;
  esac
}

authenticated_git_url() {
  local url="$1"
  local token="${GIT_TOKEN:-${GITHUB_TOKEN:-}}"
  local user="${GIT_USERNAME:-git}"

  if [[ -z "$token" || "$url" != https://* ]]; then
    printf '%s' "$url"
    return 0
  fi

  case "${GIT_PROVIDER:-generic}" in
    github)
      printf '%s' "$url" | sed "s#https://#https://x-access-token:${token}@#"
      ;;
    gitlab|gitea)
      printf '%s' "$url" | sed "s#https://#https://oauth2:${token}@#"
      ;;
    *)
      printf '%s' "$url" | sed "s#https://#https://${user}:${token}@#"
      ;;
  esac
}

mask_git_url() {
  local url="$1"
  printf '%s' "$url" | sed -E 's#(https://)[^/@]+@#\1***masked***@#'
}

ensure_root_kustomization_has_resource() {
  local kfile="$1"
  local resource="$2"

  mkdir -p "$(dirname "$kfile")"
  if [[ ! -f "$kfile" ]]; then
    cat > "$kfile" <<EOF
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - gotk-components.yaml
  - gotk-sync.yaml
  - ${resource}
EOF
    return 0
  fi

  if grep -qE "^[[:space:]]*-[[:space:]]*${resource}([[:space:]]*)$" "$kfile"; then
    return 0
  fi

  if grep -qE '^resources:' "$kfile"; then
    awk -v res="$resource" '
      {print}
      /^resources:/ && !done {print "  - " res; done=1}
    ' "$kfile" > "${kfile}.tmp"
    mv "${kfile}.tmp" "$kfile"
  else
    cat >> "$kfile" <<EOF

resources:
  - ${resource}
EOF
  fi
}

write_public_repo_flux_manifests() {
  local base="$1"
  local app
  app="$(sanitize_dns_name "$PUBLIC_APP_NAME")"
  local ns
  ns="$(sanitize_dns_name "$PUBLIC_APP_NAMESPACE")"
  local appdir="$base/${GITOPS_COMMIT_PATH}/apps/${app}"
  mkdir -p "$appdir"

  cat > "$appdir/namespace.yaml" <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: ${ns}
  labels:
    app.kubernetes.io/managed-by: fluxonm
    app.kubernetes.io/part-of: ${app}
EOF

  cat > "$appdir/source.yaml" <<EOF
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: ${app}-source
  namespace: ${FLUX_NAMESPACE}
  labels:
    app.kubernetes.io/managed-by: fluxonm
spec:
  interval: ${PUBLIC_APP_INTERVAL}
  url: ${PUBLIC_APP_REPO_URL}
  ref:
    branch: ${PUBLIC_APP_REPO_BRANCH}
EOF

  cat > "$appdir/kustomization-app.yaml" <<EOF
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: ${app}
  namespace: ${FLUX_NAMESPACE}
  labels:
    app.kubernetes.io/managed-by: fluxonm
spec:
  interval: ${PUBLIC_APP_INTERVAL}
  retryInterval: 30s
  timeout: ${PUBLIC_APP_TIMEOUT}
  sourceRef:
    kind: GitRepository
    name: ${app}-source
  path: ${PUBLIC_APP_REPO_PATH}
  prune: true
  wait: true
  targetNamespace: ${ns}
EOF

  cat > "$appdir/kustomization.yaml" <<EOF
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - namespace.yaml
  - source.yaml
  - kustomization-app.yaml
EOF

  ensure_root_kustomization_has_resource "$base/${GITOPS_COMMIT_PATH}/kustomization.yaml" "apps/${app}"
}

cmd_public_repo_deploy_wizard() {
  require_management

  clear_screen
  banner
  status_header
  dashboard_snapshot

  section "Public Repo GitOps Deployment Wizard"
  echo "This workflow does the following:"
  echo "  1. Bootstraps Flux into your GitOps repository/path if required"
  echo "  2. Creates a separate application namespace"
  echo "  3. Commits GitRepository + Kustomization source-of-truth YAML into your GitOps repo"
  echo "  4. Pushes the commit"
  echo "  5. Reconciles Flux so the public repository deploys into your local cluster"
  echo

  PUBLIC_APP_NAME="$(read_value "Application name" "${PUBLIC_APP_NAME:-public-demo}")"
  PUBLIC_APP_NAME="$(sanitize_dns_name "$PUBLIC_APP_NAME")"
  PUBLIC_APP_NAMESPACE="$(read_value "Separate application namespace" "${PUBLIC_APP_NAMESPACE:-${PUBLIC_APP_NAME}}")"
  PUBLIC_APP_NAMESPACE="$(sanitize_dns_name "$PUBLIC_APP_NAMESPACE")"
  PUBLIC_APP_REPO_URL="$(read_value "Public Git repo URL to deploy" "${PUBLIC_APP_REPO_URL:-https://github.com/stefanprodan/podinfo}")"
  PUBLIC_APP_REPO_BRANCH="$(read_value "Public repo branch" "${PUBLIC_APP_REPO_BRANCH:-master}")"
  PUBLIC_APP_REPO_PATH="$(read_value "Path inside public repo" "${PUBLIC_APP_REPO_PATH:-./kustomize}")"
  PUBLIC_APP_INTERVAL="$(read_value "Flux sync interval" "${PUBLIC_APP_INTERVAL:-1m}")"
  PUBLIC_APP_TIMEOUT="$(read_value "Flux deploy timeout" "${PUBLIC_APP_TIMEOUT:-5m}")"

  print_public_repo_examples
  GITOPS_COMMIT_BRANCH="$(read_branch_guarded "Your GitOps repo branch" "${GITOPS_COMMIT_BRANCH:-${GIT_BRANCH:-main}}")"
  GITOPS_COMMIT_PATH="$(read_value "New/existing Flux source-of-truth path" "${GITOPS_COMMIT_PATH:-${GIT_PATH:-clusters/dev}}")"
  GIT_COMMIT_USER_NAME="$(read_value "Git commit user.name" "${GIT_COMMIT_USER_NAME:-FLUXONM Bot}")"
  GIT_COMMIT_USER_EMAIL="$(read_value "Git commit user.email" "${GIT_COMMIT_USER_EMAIL:-fluxonm@example.local}")"

  local derived_url
  derived_url="$(derive_gitops_commit_url || true)"
  GITOPS_COMMIT_REPO_URL="$(read_value "Your GitOps repo clone URL" "${GITOPS_COMMIT_REPO_URL:-$derived_url}")"

  # Guardrail: if user accidentally entered URL in branch prompt, move it to repo URL.
  if looks_like_git_url "$GITOPS_COMMIT_BRANCH"; then
    warn "Detected Git URL in branch field. Moving it to GitOps repo URL and resetting branch to main."
    GITOPS_COMMIT_REPO_URL="$GITOPS_COMMIT_BRANCH"
    GITOPS_COMMIT_BRANCH="main"
  fi

  sync_gitops_bootstrap_vars

  if ! validate_public_repo_inputs; then
    die "Public repo deployment inputs are invalid. Re-run wizard and correct highlighted fields."
  fi

  save_prefs

  section "Execution Plan Preview"
  echo "Provider              : ${GIT_PROVIDER}"
  echo "Cluster Context       : ${KUBE_CONTEXT}"
  echo "Flux Namespace        : ${FLUX_NAMESPACE}"
  echo "GitOps Repo           : ${GITOPS_COMMIT_REPO_URL}"
  echo "GitOps Branch         : ${GITOPS_COMMIT_BRANCH}"
  echo "GitOps Path           : ${GITOPS_COMMIT_PATH}"
  echo "App Name              : ${PUBLIC_APP_NAME}"
  echo "App Namespace         : ${PUBLIC_APP_NAMESPACE}"
  echo "Public Repo           : ${PUBLIC_APP_REPO_URL}"
  echo "Public Repo Branch    : ${PUBLIC_APP_REPO_BRANCH}"
  echo "Public Repo Path      : ${PUBLIC_APP_REPO_PATH}"
  echo
  echo "Commands will be previewed before execution and sensitive token values are masked."
  echo
  read -r -p "Proceed with full bootstrap + source-of-truth commit + deploy? [y/N]: " proceed || true
  [[ "$proceed" =~ ^[Yy]$ ]] || { warn "Public repo deployment cancelled"; return 0; }

  section "Step 1: Bootstrap Flux GitOps repo/path"
  sync_gitops_bootstrap_vars
  show_command_preview "Flux bootstrap selected provider" bash -lc "$(gitops_build_command_display masked)"
  read -r -p "Run Flux bootstrap now? [Y/n]: " run_bootstrap || true
  run_bootstrap="${run_bootstrap:-Y}"
  if [[ "$run_bootstrap" =~ ^[Yy]$ ]]; then
    cmd_gitops_deploy
  else
    warn "Skipping bootstrap by user choice"
  fi

  section "Step 2: Clone GitOps repository and write source-of-truth"
  local workdir clone_url masked_url
  workdir="$(mktemp -d)"
  clone_url="$(authenticated_git_url "$GITOPS_COMMIT_REPO_URL")"
  masked_url="$(mask_git_url "$clone_url")"

  show_command_preview "Clone GitOps repo" git clone --branch "$GITOPS_COMMIT_BRANCH" "$masked_url" "$workdir/repo"
  git clone --branch "$GITOPS_COMMIT_BRANCH" "$clone_url" "$workdir/repo"

  git -C "$workdir/repo" config user.name "$GIT_COMMIT_USER_NAME"
  git -C "$workdir/repo" config user.email "$GIT_COMMIT_USER_EMAIL"

  write_public_repo_flux_manifests "$workdir/repo"

  section "Generated source-of-truth files"
  find "$workdir/repo/${GITOPS_COMMIT_PATH}/apps/${PUBLIC_APP_NAME}" -maxdepth 2 -type f -print | sed 's/^/  /'
  echo
  echo "Root kustomization: $workdir/repo/${GITOPS_COMMIT_PATH}/kustomization.yaml"

  section "Git diff preview"
  git -C "$workdir/repo" status --short
  git -C "$workdir/repo" diff -- "${GITOPS_COMMIT_PATH}" || true

  echo
  read -r -p "Commit and push these source-of-truth changes? [y/N]: " commit_push || true
  [[ "$commit_push" =~ ^[Yy]$ ]] || { warn "Commit/push cancelled; working copy kept at $workdir/repo"; return 0; }

  show_command_preview "Git commit" git add "$GITOPS_COMMIT_PATH" '&&' git commit -m "FLUXONM deploy ${PUBLIC_APP_NAME} from public repo"
  git -C "$workdir/repo" add "$GITOPS_COMMIT_PATH"
  if git -C "$workdir/repo" diff --cached --quiet; then
    warn "No changes to commit"
  else
    git -C "$workdir/repo" commit -m "FLUXONM deploy ${PUBLIC_APP_NAME} from public repo"
  fi

  show_command_preview "Git push" git push origin "$GITOPS_COMMIT_BRANCH"
  git -C "$workdir/repo" push origin "$GITOPS_COMMIT_BRANCH"

  section "Step 3: Reconcile Flux"
  if kubectl_ctx get gitrepositories -n "$FLUX_NAMESPACE" flux-system >/dev/null 2>&1; then
    show_command_preview "Reconcile bootstrap source" flux reconcile source git flux-system -n "$FLUX_NAMESPACE" --with-source
    flux_ctx reconcile source git flux-system -n "$FLUX_NAMESPACE" --with-source || true
  fi
  show_command_preview "Reconcile app source" flux reconcile source git "${PUBLIC_APP_NAME}-source" -n "$FLUX_NAMESPACE" --with-source
  flux_ctx reconcile source git "${PUBLIC_APP_NAME}-source" -n "$FLUX_NAMESPACE" --with-source || true
  show_command_preview "Reconcile app kustomization" flux reconcile kustomization "$PUBLIC_APP_NAME" -n "$FLUX_NAMESPACE" --with-source
  flux_ctx reconcile kustomization "$PUBLIC_APP_NAME" -n "$FLUX_NAMESPACE" --with-source || true

  section "Deployment Status"
  kubectl_ctx get ns "$PUBLIC_APP_NAMESPACE" || true
  kubectl_ctx get all -n "$PUBLIC_APP_NAMESPACE" -o wide || true
  flux_ctx get sources git -n "$FLUX_NAMESPACE" || true
  flux_ctx get kustomizations -n "$FLUX_NAMESPACE" || true

  audit "public-repo-deploy" "app=${PUBLIC_APP_NAME} ns=${PUBLIC_APP_NAMESPACE} public=${PUBLIC_APP_REPO_URL} gitops=${GITOPS_COMMIT_REPO_URL}/${GITOPS_COMMIT_PATH}"
  ok "Public repo deployment workflow completed"
}


