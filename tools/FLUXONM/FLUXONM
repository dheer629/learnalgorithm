read_value() {
  local prompt="$1"
  local current="${2:-}"
  local secret="${3:-0}"
  local value=""

  if [[ "$secret" == "1" ]]; then
    if [[ -n "$current" ]]; then
      read -r -p "$prompt [configured, press Enter to keep]: " value || true
      if [[ -z "$value" ]]; then
        printf '%s' "$current"
      else
        printf '%s' "$value"
      fi
    else
      read -r -s -p "$prompt: " value || true
      echo >&2
      printf '%s' "$value"
    fi
  else
    read -r -p "$prompt [$current]: " value || true
    printf '%s' "${value:-$current}"
  fi
}

