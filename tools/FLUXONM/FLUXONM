gitops_supported_providers() {
  cat <<'PROVIDERS'
github
gitlab
gitea
bitbucket-server
generic
azure-devops
aws-codecommit
google-cloud-source
bitbucket-cloud
PROVIDERS
}

gitops_provider_summary() {
  case "${GIT_PROVIDER:-generic}" in
    github|gitlab|gitea|bitbucket-server)
      printf '%s │ %s/%s │ branch=%s │ path=%s │ auth=%s' \
        "${GIT_PROVIDER}" "${GIT_OWNER:-unset}" "${GIT_REPOSITORY:-unset}" "${GIT_BRANCH:-main}" "${GIT_PATH:-clusters/dev}" "${GIT_AUTH_MODE:-token}"
      ;;
    generic|azure-devops|aws-codecommit|google-cloud-source|bitbucket-cloud)
      printf '%s │ %s │ branch=%s │ path=%s │ auth=%s' \
        "${GIT_PROVIDER}" "$(safe_short "${GIT_URL:-unset}" 52)" "${GIT_BRANCH:-main}" "${GIT_PATH:-clusters/dev}" "${GIT_AUTH_MODE:-token}"
      ;;
    *)
      printf '%s │ not configured' "${GIT_PROVIDER:-unset}"
      ;;
  esac
}

mask_secret() {
  local v="${1:-}"
  if [[ -z "$v" ]]; then
    printf 'not configured'
  else
    printf 'configured (masked, len=%s)' "${#v}"
  fi
}

append_extra_flags() {
  local -n _arr="$1"
  if [[ -n "${GIT_EXTRA_FLAGS:-}" ]]; then
    # shellcheck disable=SC2206
    local extra=( ${GIT_EXTRA_FLAGS} )
    _arr+=("${extra[@]}")
  fi
}

gitops_build_command_display() {
  local masked="${1:-masked}"
  local token="${GIT_TOKEN:-}"
  local password="${GIT_PASSWORD:-}"

  [[ "$masked" == "masked" ]] && token="***masked***" && password="***masked***"

  case "$GIT_PROVIDER" in
    github)
      echo "GITHUB_TOKEN=${token} flux bootstrap github --owner=${GIT_OWNER} --repository=${GIT_REPOSITORY} --branch=${GIT_BRANCH} --path=${GIT_PATH} --namespace=${FLUX_NAMESPACE} --token-auth ${GIT_HOSTNAME:+--hostname=${GIT_HOSTNAME}} ${GIT_PERSONAL:+--personal}"
      ;;
    gitlab)
      echo "GITLAB_TOKEN=${token} flux bootstrap gitlab --owner=${GIT_OWNER} --repository=${GIT_REPOSITORY} --branch=${GIT_BRANCH} --path=${GIT_PATH} --namespace=${FLUX_NAMESPACE} --token-auth ${GIT_HOSTNAME:+--hostname=${GIT_HOSTNAME}}"
      ;;
    gitea)
      echo "GITEA_TOKEN=${token} flux bootstrap gitea --owner=${GIT_OWNER} --repository=${GIT_REPOSITORY} --branch=${GIT_BRANCH} --path=${GIT_PATH} --namespace=${FLUX_NAMESPACE} --token-auth ${GIT_HOSTNAME:+--hostname=${GIT_HOSTNAME}}"
      ;;
    bitbucket-server)
      echo "BITBUCKET_TOKEN=${token} flux bootstrap bitbucket-server --owner=${GIT_OWNER} --repository=${GIT_REPOSITORY} --branch=${GIT_BRANCH} --path=${GIT_PATH} --namespace=${FLUX_NAMESPACE} --hostname=${GIT_HOSTNAME} --username=${GIT_USERNAME} --token-auth"
      ;;
    generic|azure-devops|aws-codecommit|google-cloud-source|bitbucket-cloud)
      case "$GIT_AUTH_MODE" in
        ssh)
          echo "flux bootstrap git --url=${GIT_URL} --branch=${GIT_BRANCH} --path=${GIT_PATH} --namespace=${FLUX_NAMESPACE} --private-key-file=${GIT_PRIVATE_KEY_FILE} ${password:+--password=${password}} ${GIT_EXTRA_FLAGS}"
          ;;
        bearer)
          echo "flux bootstrap git --url=${GIT_URL} --branch=${GIT_BRANCH} --path=${GIT_PATH} --namespace=${FLUX_NAMESPACE} --password=${token} --with-bearer-token ${GIT_EXTRA_FLAGS}"
          ;;
        basic|token)
          echo "flux bootstrap git --url=${GIT_URL} --branch=${GIT_BRANCH} --path=${GIT_PATH} --namespace=${FLUX_NAMESPACE} --username=${GIT_USERNAME} --password=${token} ${GIT_EXTRA_FLAGS}"
          ;;
        none)
          echo "flux bootstrap git --url=${GIT_URL} --branch=${GIT_BRANCH} --path=${GIT_PATH} --namespace=${FLUX_NAMESPACE} ${GIT_EXTRA_FLAGS}"
          ;;
      esac
      ;;
  esac
}

cmd_gitops_print_command() {
  header
  require_supervision
  section "Generated Bootstrap Command"
  gitops_build_command_display masked
}

cmd_gitops_provider_select() {
  require_management

  local providers=()
  mapfile -t providers < <(gitops_supported_providers)

  local selected rc
  set +e
  selected="$(select_from_list "Select Flux-supported Git provider" "${providers[@]}")"
  rc=$?
  set -e

  [[ $rc -eq 0 ]] || { warn "Provider selection cancelled."; return 0; }

  GIT_PROVIDER="$selected"

  case "$GIT_PROVIDER" in
    github) GIT_AUTH_MODE="token"; GIT_HOSTNAME="${GIT_HOSTNAME:-github.com}" ;;
    gitlab) GIT_AUTH_MODE="token"; GIT_HOSTNAME="${GIT_HOSTNAME:-gitlab.com}" ;;
    gitea) GIT_AUTH_MODE="token" ;;
    bitbucket-server) GIT_AUTH_MODE="token" ;;
    azure-devops) GIT_AUTH_MODE="ssh" ;;
    aws-codecommit) GIT_AUTH_MODE="ssh" ;;
    google-cloud-source) GIT_AUTH_MODE="ssh" ;;
    bitbucket-cloud) GIT_AUTH_MODE="basic" ;;
    generic) GIT_AUTH_MODE="${GIT_AUTH_MODE:-token}" ;;
  esac

  save_prefs
  ok "Git provider selected: $GIT_PROVIDER"
}

