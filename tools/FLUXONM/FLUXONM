# ------------------------------------------------------------------------------
# v6.3 persistent output history + output browser
# ------------------------------------------------------------------------------

history_write_index() {
  local label="$1"
  local file="$2"
  local rc="${3:-0}"
  mkdir -p "$HISTORY_DIR" 2>/dev/null || true
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date -Is)" \
    "$RUN_ID" \
    "${MODE:-unset}" \
    "${KUBE_CONTEXT:-unset}" \
    "$rc" \
    "$label | $file" >> "$COMMAND_INDEX"
}

history_append_master() {
  local label="$1"
  local file="$2"
  local rc="${3:-0}"

  {
    echo
    echo "################################################################################"
    echo "# FLUXONM HISTORY ENTRY"
    echo "# timestamp : $(date -Is)"
    echo "# run_id    : $RUN_ID"
    echo "# label     : $label"
    echo "# rc        : $rc"
    echo "# mode      : ${MODE:-unset}"
    echo "# context   : ${KUBE_CONTEXT:-unset}"
    echo "# namespace : ${ACTIVE_NAMESPACE:-unset}"
    echo "# file      : $file"
    echo "################################################################################"
    [[ -f "$file" ]] && cat "$file"
    echo
    echo "################################################################################"
    echo "# END FLUXONM HISTORY ENTRY: $label"
    echo "################################################################################"
  } >> "$MASTER_LOG" 2>/dev/null || true
}

capture_stream() {
  local label="$1"
  shift
  local safe_label
  safe_label="$(printf '%s' "$label" | tr -cs 'A-Za-z0-9._-' '_' | sed 's/_$//')"
  local file="$OUTDIR/${safe_label}.log"

  mkdir -p "$OUTDIR" "$HISTORY_DIR"

  {
    echo "### FLUXONM capture"
    echo "### label      : $label"
    echo "### timestamp  : $(date -Is)"
    echo "### run_id     : $RUN_ID"
    echo "### mode       : ${MODE:-unset}"
    echo "### context    : ${KUBE_CONTEXT:-unset}"
    echo "### namespace  : ${ACTIVE_NAMESPACE:-unset}"
    echo "### command    : $*"
    echo
    "$@"
  } 2>&1 | tee "$file"

  local rc=${PIPESTATUS[0]}
  history_write_index "$label" "$file" "$rc"
  history_append_master "$label" "$file" "$rc"

  echo
  if [[ $rc -eq 0 ]]; then
    ok "Output captured: $file"
  else
    warn "Command exited rc=$rc; output captured: $file"
  fi
  echo "Persistent history:"
  echo "  $MASTER_LOG"
  echo "Latest output link:"
  echo "  $LATEST_DIR_LINK"
  return $rc
}

capture_block() {
  local label="$1"
  local safe_label
  safe_label="$(printf '%s' "$label" | tr -cs 'A-Za-z0-9._-' '_' | sed 's/_$//')"
  local file="$OUTDIR/${safe_label}.log"

  mkdir -p "$OUTDIR" "$HISTORY_DIR"

  {
    echo "### FLUXONM capture"
    echo "### label      : $label"
    echo "### timestamp  : $(date -Is)"
    echo "### run_id     : $RUN_ID"
    echo "### mode       : ${MODE:-unset}"
    echo "### context    : ${KUBE_CONTEXT:-unset}"
    echo "### namespace  : ${ACTIVE_NAMESPACE:-unset}"
    echo
    cat
  } | tee "$file"

  local rc=${PIPESTATUS[0]}
  history_write_index "$label" "$file" "$rc"
  history_append_master "$label" "$file" "$rc"

  echo
  ok "Output captured: $file"
  echo "Persistent history:"
  echo "  $MASTER_LOG"
  echo "Latest output link:"
  echo "  $LATEST_DIR_LINK"
}

cmd_output_history() {
  header
  require_supervision

  section "FLUXONM Persistent Output History"
  echo "History dir       : $HISTORY_DIR"
  echo "Master log        : $MASTER_LOG"
  echo "Command index     : $COMMAND_INDEX"
  echo "Latest output     : $LATEST_DIR_LINK"
  echo

  if [[ ! -s "$COMMAND_INDEX" ]]; then
    warn "No command history found yet."
    return 0
  fi

  echo "Recent command captures:"
  echo
  tail -50 "$COMMAND_INDEX" | awk -F'\t' '
    {
      printf "%3d  %-25s  run=%-18s  mode=%-11s rc=%-3s  %s\n", NR, $1, $2, $3, $5, $6
    }'
  echo
  echo "Open full master log:"
  echo "  FLUXONM output-master"
  echo
  echo "Open latest output directory:"
  echo "  FLUXONM output-latest"
}

cmd_output_master() {
  header
  require_supervision

  if [[ ! -s "$MASTER_LOG" ]]; then
    warn "Master history log is empty: $MASTER_LOG"
    return 0
  fi

  viewer "$MASTER_LOG"
}

cmd_output_latest() {
  header
  require_supervision

  section "Latest Output Directory"
  echo "$LATEST_DIR_LINK"
  echo

  if [[ ! -d "$LATEST_DIR_LINK" ]]; then
    warn "Latest output directory not found."
    return 0
  fi

  find "$LATEST_DIR_LINK" -maxdepth 1 -type f -printf "%TY-%Tm-%Td %TH:%TM:%TS %p\n" 2>/dev/null | sort || true
}

cmd_output_runs() {
  header
  require_supervision

  section "All Output Runs"
  find "$OUT_ROOT" -mindepth 1 -maxdepth 1 -type d -printf "%TY-%Tm-%Td %TH:%TM:%TS %p\n" 2>/dev/null | sort -r | head -100 || true
}

cmd_output_open() {
  header
  require_supervision

  if [[ ! -s "$COMMAND_INDEX" ]]; then
    warn "No command history available."
    return 0
  fi

  local entries=()
  mapfile -t entries < <(tail -50 "$COMMAND_INDEX" | awk -F'\t' '{print $1 " | rc=" $5 " | " $6}')

  local selected rc file
  set +e
  selected="$(select_from_list "Select captured output to open" "${entries[@]}")"
  rc=$?
  set -e

  [[ $rc -eq 0 ]] || { warn "Output open cancelled."; return 0; }

  file="$(awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}' <<<"$selected")"

  if [[ -f "$file" ]]; then
    viewer "$file"
  else
    warn "Output file not found: $file"
  fi
}

cmd_output_bundle_all() {
  header
  require_supervision

  local bundle="$HISTORY_DIR/fluxonm-all-history-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar -czf "$bundle" -C "$STATE_DIR" history output logs 2>/dev/null || true
  ok "All history bundle created: $bundle"
  ls -lh "$bundle" 2>/dev/null || true
}

cmd_capture-last() {
  header
  require_supervision
  cmd_output_latest
}

cmd_output_bundle() {
  header
  require_supervision
  local bundle="$OUTDIR/fluxonm-output-bundle-$RUN_ID.tar.gz"
  tar -czf "$bundle" -C "$OUTDIR" . 2>/dev/null || true
