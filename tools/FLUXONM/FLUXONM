    *) die "Unsupported key: $key" ;;
  esac

  if declare -F normalize_gitops_inputs >/dev/null 2>&1; then
    normalize_gitops_inputs
  fi

  save_prefs
  audit "set" "key=$key"
  ok "Set $key"
