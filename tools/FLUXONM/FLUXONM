list_kubeconfigs() {
  local files=()

  [[ -n "${KUBECONFIG:-}" ]] && IFS=':' read -ra files <<< "$KUBECONFIG"
  [[ -f "$HOME/.kube/config" ]] && files+=("$HOME/.kube/config")

  while IFS= read -r f; do
    files+=("$f")
  done < <(find "$HOME/.kube" -maxdepth 1 -type f \( -name "*.kubeconfig" -o -name "config" \) 2>/dev/null || true)

  printf '%s\n' "${files[@]}" | awk 'NF' | awk '!seen[$0]++'
}

cmd_context_select() {
  header
  step "Kubeconfig / Context Selection"

  if [[ "${ALLOW_CONTEXT_SWITCH:-0}" != "1" ]]; then
    warn "Context selection changes the execution target and lock candidate."
    read -r -p "Continue with context selection? [y/N]: " continue_ctx || true
    [[ "$continue_ctx" =~ ^[Yy]$ ]] || { warn "Context selection cancelled"; return 0; }
  fi

  local files=()
  mapfile -t files < <(list_kubeconfigs)

  if [[ ${#files[@]} -eq 0 ]]; then
    warn "No kubeconfig files detected under ~/.kube."
    read -r -p "Enter kubeconfig path [$KUBECONFIG_PATH]: " entered || true
    KUBECONFIG_PATH="${entered:-$KUBECONFIG_PATH}"
  else
    echo "Available kubeconfig files:"
    local i=1
    for f in "${files[@]}"; do
      printf '  [%s] %s\n' "$i" "$f"
      i=$((i+1))
    done

    read -r -p "Select kubeconfig number or Enter for current [$KUBECONFIG_PATH]: " choice || true
    if [[ -n "$choice" ]]; then
      [[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid kubeconfig selection"
      (( choice >= 1 && choice <= ${#files[@]} )) || die "Invalid kubeconfig selection"
      KUBECONFIG_PATH="${files[$((choice-1))]}"
    fi
  fi

  export KUBECONFIG="$KUBECONFIG_PATH"
  [[ -s "$KUBECONFIG_PATH" ]] || die "Kubeconfig not found: $KUBECONFIG_PATH"

  local contexts=()
  mapfile -t contexts < <(kubectl config get-contexts -o name 2>/dev/null || true)

  [[ ${#contexts[@]} -gt 0 ]] || die "No contexts found in kubeconfig: $KUBECONFIG_PATH"

  echo
  echo "Available contexts:"
  local j=1
  local current
  current="$(kubectl config current-context 2>/dev/null || true)"

  for ctx in "${contexts[@]}"; do
    if [[ "$ctx" == "$current" ]]; then
      printf '  [%s] %s  %b(current)%b\n' "$j" "$ctx" "$C_GREEN" "$C_RESET"
    else
      printf '  [%s] %s\n' "$j" "$ctx"
    fi
    j=$((j+1))
  done

  read -r -p "Select context number or Enter for current [$current]: " ctx_choice || true

  if [[ -n "$ctx_choice" ]]; then
    [[ "$ctx_choice" =~ ^[0-9]+$ ]] || die "Invalid context selection"
    (( ctx_choice >= 1 && ctx_choice <= ${#contexts[@]} )) || die "Invalid context selection"
    KUBE_CONTEXT="${contexts[$((ctx_choice-1))]}"
  else
    KUBE_CONTEXT="${KUBE_CONTEXT:-$current}"
  fi

  [[ -n "$KUBE_CONTEXT" ]] || die "Kubernetes context could not be resolved"

  if ! kubectl --context "$KUBE_CONTEXT" get nodes >/dev/null 2>&1; then
    warn "Selected context is not reachable: $KUBE_CONTEXT"
    read -r -p "Continue anyway? [y/N]: " cont || true
    [[ "$cont" =~ ^[Yy]$ ]] || die "Context selection aborted"
  fi

  LOCKED_CONTEXT="$KUBE_CONTEXT"
  LOCKED_CLUSTER_SERVER="$(current_cluster_server "$KUBE_CONTEXT")"

  save_prefs
  ok "Context selected and saved: $KUBE_CONTEXT"
}

cmd_namespace_select() {
  header
  step "Namespace Selection / Lock"

  if [[ "${ALLOW_NAMESPACE_SWITCH:-0}" != "1" ]]; then
    warn "Namespace selection changes the namespace lock."
    read -r -p "Continue with namespace selection? [y/N]: " continue_ns || true
    [[ "$continue_ns" =~ ^[Yy]$ ]] || { warn "Namespace selection cancelled"; return 0; }
  fi

  export_kubeconfig

  local namespaces=()
  if kubectl_ctx get ns >/dev/null 2>&1; then
    mapfile -t namespaces < <(kubectl_ctx get ns --no-headers 2>/dev/null | awk '{print $1}' | sort)
  fi

  if [[ ${#namespaces[@]} -eq 0 ]]; then
    warn "Unable to list namespaces. You can still type a namespace manually."
    read -r -p "Namespace to lock [${ACTIVE_NAMESPACE:-default}]: " ns || true
    ACTIVE_NAMESPACE="${ns:-${ACTIVE_NAMESPACE:-default}}"
  else
    echo "Available namespaces:"
    local i=1
    for ns in "${namespaces[@]}"; do
      if [[ "$ns" == "$ACTIVE_NAMESPACE" || "$ns" == "$LOCKED_NAMESPACE" ]]; then
        printf '  [%s] %s  %b(current/locked)%b\n' "$i" "$ns" "$C_GREEN" "$C_RESET"
      else
        printf '  [%s] %s\n' "$i" "$ns"
      fi
      i=$((i+1))
    done
    echo "  [M] Manual namespace"

    read -r -p "Select namespace number, M for manual, or Enter for [$ACTIVE_NAMESPACE]: " choice || true

    if [[ -z "$choice" ]]; then
      ACTIVE_NAMESPACE="${ACTIVE_NAMESPACE:-default}"
    elif [[ "$choice" =~ ^[Mm]$ ]]; then
      read -r -p "Namespace to lock: " manual_ns || true
      [[ -n "$manual_ns" ]] || die "Namespace cannot be empty"
      ACTIVE_NAMESPACE="$manual_ns"
    else
      [[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid namespace selection"
      (( choice >= 1 && choice <= ${#namespaces[@]} )) || die "Invalid namespace selection"
      ACTIVE_NAMESPACE="${namespaces[$((choice-1))]}"
    fi
  fi

  LOCKED_NAMESPACE="$ACTIVE_NAMESPACE"

  if ! kubectl_ctx get ns "$ACTIVE_NAMESPACE" >/dev/null 2>&1; then
    warn "Namespace does not exist: $ACTIVE_NAMESPACE"
    if [[ "$MODE" == "MANAGEMENT" ]]; then
      read -r -p "Create namespace $ACTIVE_NAMESPACE now? [y/N]: " create_ns || true
      if [[ "$create_ns" =~ ^[Yy]$ ]]; then
        kubectl_ctx create namespace "$ACTIVE_NAMESPACE" --dry-run=client -o yaml | kubectl_ctx apply -f -
        ok "Namespace created: $ACTIVE_NAMESPACE"
      fi
    fi
  fi

  save_prefs
  audit "namespace-lock" "namespace=$ACTIVE_NAMESPACE"
  ok "Namespace locked: $ACTIVE_NAMESPACE"
}

cmd_mode_select() {
  header
  step "Execution Mode Selection"

  cat <<'MODE_MENU'
Select execution mode first:

  [1] SUPERVISION  - read-only, safest default
  [2] MANAGEMENT   - mutating actions, confirmation gated

MODE_MENU

  read -r -p "Choose mode [1]: " mode_choice || true
  mode_choice="${mode_choice:-1}"

  case "$mode_choice" in
    1)
      MODE="SUPERVISION"
      ;;
    2)
      MODE="MANAGEMENT"
      echo
      warn "MANAGEMENT mode can modify the cluster."
      read -r -p "Type MANAGEMENT to enable management mode: " typed || true
      [[ "$typed" == "MANAGEMENT" ]] || die "Management mode not enabled"
      ;;
    *)
      die "Invalid mode selection"
      ;;
  esac

  ok "Mode selected: $MODE"
}

cmd_start() {
  clear_screen
  banner

  cmd_mode_select
  ALLOW_CONTEXT_SWITCH=1 cmd_context_select
  ALLOW_NAMESPACE_SWITCH=1 cmd_namespace_select

  echo
  ok "Startup control plane completed"
  cmd_lock_show
  pause_return

  if [[ "$MODE" == "MANAGEMENT" ]]; then
    dashboard_management
  else
    dashboard_supervision
  fi
}


