EXECUTION_TIMEOUT_SECONDS=5
EXECUTION_OUTPUT_LIMIT_BYTES=200000
VISUALIZATION_RESPONSE_LIMIT_BYTES=500000
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
IMAGE_TAG=local
IMAGE_REGISTRY=
