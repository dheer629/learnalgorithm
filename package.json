{
  "name": "algorithm-learn",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "docker compose up --build",
    "frontend:dev": "npm --workspace frontend run dev",
    "backend:dev": "cd backend && uvicorn app.main:app --reload",
    "lint": "npm --workspace frontend run lint",
    "test": "npm --workspace frontend run test",
    "frontend:build": "npm --workspace frontend run build",
    "backend:lint": "cd backend && python -m ruff check . && python -m black --check .",
    "backend:test": "cd backend && python -m pytest",
    "migrate": "cd backend && alembic upgrade head",
    "sync": "curl -X POST http://localhost:8000/api/admin/sync -H \"X-Admin-Token: local-admin-token\"",
    "ci": "npm run backend:lint && npm run backend:test && npm run lint && npm run test && npm run frontend:build"
  }
}
